export struct PaletteEntry {
    is_header: bool,
    candidate_index: int,
    title: string,
    subtitle: string,
    badge: string,
    icon: string,
    can_elevate: bool,
}

export struct AppToggleEntry {
    name: string,
    path: string,
    enabled: bool,
}

export struct BuiltinToggleEntry {
    id: string,
    title: string,
    subtitle: string,
    enabled: bool,
}

export struct CustomCmdEntry {
    name: string,
    command: string,
}

export struct CustomSettingEntry {
    name: string,
    path: string,
}

export struct BangRuleEntry {
    trigger: string,
    url_template: string,
}

export struct CategoryOrderEntry {
    id: string,
    display_name: string,
    description: string,
    icon: string,
}

export struct ExtensionUiEntry {
    id: string,
    name: string,
    description: string,
    bang: string,
    icon: string,
    kind: string,
    target_file: string,
    target_meta: string,
    is_file_backed: bool,
    enabled: bool,
    is_builtin: bool,
}

export component PaletteWindow inherits Window {
    title: "Command Palette";
    icon: root.app_icon;
    no-frame: true;
    always-on-top: true;
    width: 680px;
    height: root.entries.length == 0 ? 66px : (66px + min(root.entries.length, 9) * 44px + 40px);

    in-out property <image> app_icon;

    in property <color> theme_window_bg: #1f1f1f;
    in property <color> theme_surface_bg: #2b2b2b;
    in property <color> theme_card_bg: #282828;
    in property <color> theme_selected_bg: #383838;
    in property <color> theme_border: #3d3d3d;
    in property <color> theme_accent: #60cdff;
    in property <color> theme_text_primary: #ffffff;
    in property <color> theme_text_muted: #9d9d9d;

    background: root.theme_window_bg;
    default-font-family: "Segoe UI Variable Display";

    in-out property <string> query_text: "";
    in-out property <string> active_bang: "";
    in-out property <string> active_bang_label: "";
    in-out property <[PaletteEntry]> entries: [];
    in-out property <int> selected_candidate_index: 0;
    in-out property <int> total_candidates: 0;

    callback query_edited(string);
    callback clear_active_bang();
    callback move_selection(int);
    callback trigger_selected(bool);
    callback trigger_candidate_at(int, bool);
    callback open_settings_window();
    callback hide_requested();

    public function focus_search_input() {
        search_box.focus();
    }

    Rectangle {
        width: 100%;
        height: 100%;
        background: root.theme_window_bg;
        border-color: root.theme_border;
        border-width: 1px;
        border-radius: 10px;
        clip: true;

        VerticalLayout {
            padding: 10px;
            spacing: 6px;

            Rectangle {
                height: 44px;
                background: root.theme_surface_bg;
                border-color: search_box.has-focus ? root.theme_accent : root.theme_border;
                border-width: search_box.has-focus ? 2px : 1px;
                border-radius: 8px;

                HorizontalLayout {
                    padding-left: 14px;
                    padding-right: 10px;
                    spacing: 10px;

                    Text {
                        text: "\u{E721}";
                        font-family: "Segoe Fluent Icons";
                        color: search_box.has-focus ? root.theme_accent : root.theme_text_muted;
                        font-size: 16px;
                        vertical-alignment: center;
                    }

                    if root.active_bang != "" : Rectangle {
                        height: 26px;
                        width: bang_chip_layout.preferred-width + 16px;
                        y: (parent.height - self.height) / 2;
                        background: root.theme_accent;
                        border-radius: 6px;

                        bang_chip_layout := HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            spacing: 5px;

                            Text {
                                text: root.active_bang_label != "" ? root.active_bang_label : root.active_bang;
                                color: #121212;
                                font-size: 11px;
                                font-weight: 800;
                                vertical-alignment: center;
                            }

                            Text {
                                text: "✕";
                                color: #1f1f1f;
                                font-size: 10px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }
                        }

                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.clear_active_bang();
                                search_box.focus();
                            }
                        }
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                        background: transparent;

                        Text {
                            visible: root.query_text == "";
                            text: root.active_bang == "note"
                                ? "Type note text & hit Enter to save to file, or browse saved lines below..."
                                : (root.active_bang != ""
                                    ? "Type query for [" + root.active_bang + "] (Backspace to clear chip)..."
                                    : "Type an app, 'note ' for notepad, 'settings', math (24*7), or web search...");
                            color: root.theme_text_muted;
                            font-size: 14px;
                            vertical-alignment: center;
                        }

                        search_box := TextInput {
                            width: 100%;
                            height: 100%;
                            text <=> root.query_text;
                            color: root.theme_text_primary;
                            font-size: 15px;
                            vertical-alignment: center;
                            single-line: true;

                            edited => {
                                root.query_edited(self.text);
                            }

                            key-pressed(event) => {
                                if (event.text == Key.Backspace && self.text == "" && root.active_bang != "") {
                                    root.clear_active_bang();
                                    return accept;
                                }
                                if (event.text == Key.Escape) {
                                    if (root.active_bang != "" && self.text == "") {
                                        root.clear_active_bang();
                                        return accept;
                                    }
                                    root.hide_requested();
                                    return accept;
                                }
                                if (event.text == Key.DownArrow) {
                                    root.move_selection(1);
                                    return accept;
                                }
                                if (event.text == Key.UpArrow) {
                                    root.move_selection(-1);
                                    return accept;
                                }
                                if (event.text == "," && event.modifiers.control) {
                                    root.open_settings_window();
                                    return accept;
                                }
                                if (event.text == Key.Return) {
                                    root.trigger_selected(event.modifiers.control && event.modifiers.shift);
                                    return accept;
                                }
                                return reject;
                            }
                        }
                    }

                    Rectangle {
                        width: 30px;
                        height: 30px;
                        y: (parent.height - self.height) / 2;
                        border-radius: 6px;
                        background: gear_touch.has-hover ? root.theme_selected_bg : transparent;

                        Text {
                            text: "⚙";
                            color: gear_touch.has-hover ? root.theme_accent : root.theme_text_muted;
                            font-size: 15px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        gear_touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.open_settings_window();
                            }
                        }
                    }
                }
            }

            if root.entries.length > 0 : Flickable {
                vertical-stretch: 1;

                VerticalLayout {
                    spacing: 2px;

                    for entry in root.entries : Rectangle {
                        height: entry.is_header ? 28px : 42px;
                        border-radius: 6px;
                        background: entry.is_header
                            ? transparent
                            : (entry.candidate_index == root.selected_candidate_index
                                ? root.theme_selected_bg
                                : (row_touch.has-hover ? root.theme_card_bg : transparent));

                        Rectangle {
                            visible: !entry.is_header && entry.candidate_index == root.selected_candidate_index;
                            x: 0px;
                            y: 9px;
                            width: 3px;
                            height: 24px;
                            border-radius: 2px;
                            background: root.theme_accent;
                        }

                        HorizontalLayout {
                            padding-left: entry.is_header ? 8px : 12px;
                            padding-right: 12px;
                            spacing: 10px;

                            if !entry.is_header : Rectangle {
                                width: 26px;
                                height: 26px;
                                y: (parent.height - self.height) / 2;
                                border-radius: 5px;
                                background: entry.candidate_index == root.selected_candidate_index
                                    ? root.theme_surface_bg
                                    : root.theme_card_bg;
                                border-color: root.theme_border;
                                border-width: 1px;

                                Text {
                                    text: entry.icon;
                                    font-size: 13px;
                                    color: entry.candidate_index == root.selected_candidate_index
                                        ? root.theme_accent
                                        : root.theme_text_primary;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }

                            if entry.is_header : Text {
                                text: entry.icon + "  " + entry.title;
                                color: root.theme_accent;
                                font-size: 11px;
                                font-weight: 700;
                                vertical-alignment: bottom;
                                horizontal-stretch: 1;
                                overflow: elide;
                            }

                            if !entry.is_header : VerticalLayout {
                                horizontal-stretch: 1;
                                alignment: center;
                                spacing: 1px;

                                Text {
                                    text: entry.title;
                                    color: root.theme_text_primary;
                                    font-size: 13px;
                                    font-weight: entry.candidate_index == root.selected_candidate_index ? 600 : 400;
                                    overflow: elide;
                                }

                                if entry.subtitle != "" : Text {
                                    text: entry.subtitle;
                                    color: root.theme_text_muted;
                                    font-size: 10px;
                                    overflow: elide;
                                }
                            }

                            if !entry.is_header : Rectangle {
                                width: 84px;
                                height: 20px;
                                y: (parent.height - self.height) / 2;
                                border-radius: 4px;
                                background: root.theme_surface_bg;
                                border-color: root.theme_border;
                                border-width: 1px;

                                Text {
                                    text: entry.badge;
                                    color: root.theme_text_muted;
                                    font-size: 10px;
                                    font-weight: 600;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        row_touch := TouchArea {
                            enabled: !entry.is_header;
                            mouse-cursor: entry.is_header ? default : pointer;
                            clicked => {
                                root.selected_candidate_index = entry.candidate_index;
                                root.trigger_candidate_at(entry.candidate_index, false);
                            }
                        }
                    }
                }
            }

            if root.entries.length > 0 : Rectangle {
                height: 24px;
                background: transparent;

                HorizontalLayout {
                    padding-left: 6px;
                    padding-right: 6px;
                    spacing: 14px;

                    Text {
                        text: "↵ Execute / Save Note";
                        color: root.theme_text_muted;
                        font-size: 11px;
                        vertical-alignment: center;
                    }

                    Text {
                        text: "Ctrl+Shift+↵ Admin";
                        color: root.theme_text_muted;
                        font-size: 11px;
                        vertical-alignment: center;
                    }

                    Text {
                        text: "'note ' Quick Notepad";
                        color: root.theme_accent;
                        font-size: 11px;
                        vertical-alignment: center;
                    }

                    Rectangle { horizontal-stretch: 1; }

                    Text {
                        text: "Ctrl+, CmdPal Settings";
                        color: root.theme_text_muted;
                        font-size: 11px;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}

export component SettingsWindow inherits Window {
    title: "Command Palette Settings";
    icon: root.app_icon;
    width: 840px;
    height: 620px;

    in-out property <image> app_icon;

    in property <color> theme_window_bg: #1f1f1f;
    in property <color> theme_surface_bg: #2b2b2b;
    in property <color> theme_card_bg: #282828;
    in property <color> theme_selected_bg: #383838;
    in property <color> theme_border: #3d3d3d;
    in property <color> theme_accent: #60cdff;
    in property <color> theme_text_primary: #ffffff;
    in property <color> theme_text_muted: #9d9d9d;

    background: root.theme_window_bg;
    default-font-family: "Segoe UI Variable Display";

    in-out property <int> active_tab: 0;
    in-out property <bool> show_apps: true;
    in-out property <bool> run_on_startup: false;
    in-out property <string> hotkey: "Ctrl+Space";
    in-out property <string> theme_mode: "powertoys";

    // Separated Inbuilt Shortcuts toggles
    in-out property <bool> enable_cmdpal_shortcuts: true;
    in-out property <bool> enable_builtin_cmds: true;
    in-out property <bool> enable_builtin_settings: true;
    in-out property <[BuiltinToggleEntry]> builtin_cmd_entries: [];
    in-out property <[BuiltinToggleEntry]> builtin_setting_entries: [];

    // Default Search Engine properties
    in-out property <string> default_search_engine: "google";
    in-out property <string> custom_search_url: "https://www.google.com/search?q={q}";

    // Extensions & Notepad properties
    in-out property <[ExtensionUiEntry]> extension_entries: [];
    in-out property <bool> notepad_installed: true;
    in-out property <string> notepad_file_path: "notes.md";
    in-out property <string> new_ext_name: "";
    in-out property <string> new_ext_bang: "";
    in-out property <string> new_ext_kind: "NotepadFile";
    in-out property <string> new_ext_target: "";

    in-out property <string> custom_window_bg: "#1f1f1f";
    in-out property <string> custom_surface_bg: "#2b2b2b";
    in-out property <string> custom_card_bg: "#282828";
    in-out property <string> custom_selected_bg: "#383838";
    in-out property <string> custom_border: "#3d3d3d";
    in-out property <string> custom_accent: "#60cdff";
    in-out property <string> custom_text_primary: "#ffffff";
    in-out property <string> custom_text_muted: "#9d9d9d";

    in-out property <string> custom_cmd_path: "cmd.exe";
    in-out property <string> custom_system_settings_path: "ms-settings:";

    in-out property <[CategoryOrderEntry]> category_entries: [];
    in-out property <[AppToggleEntry]> app_entries: [];
    in-out property <[string]> file_scan_paths: [];
    in-out property <[CustomCmdEntry]> custom_commands: [];
    in-out property <[CustomSettingEntry]> custom_settings: [];
    in-out property <[BangRuleEntry]> bang_entries: [];

    in-out property <string> new_scan_path: "";
    in-out property <string> new_cmd_name: "";
    in-out property <string> new_cmd_exec: "";
    in-out property <string> new_setting_name: "";
    in-out property <string> new_setting_path: "";
    in-out property <string> new_bang_trigger: "";
    in-out property <string> new_bang_url: "";
    in-out property <string> status_message: "";

    callback toggle_show_apps(bool);
    callback toggle_startup(bool);
    callback select_hotkey(string);
    callback select_theme_mode(string);
    callback apply_custom_theme(string, string, string, string, string, string, string, string);
    callback reset_custom_theme();

    callback toggle_cmdpal_shortcuts(bool);
    callback toggle_all_builtin_cmds(bool);
    callback toggle_builtin_cmd_item(string, bool);
    callback toggle_all_builtin_settings(bool);
    callback toggle_builtin_setting_item(string, bool);

    callback select_default_search_engine(string);
    callback save_custom_search_url(string);

    callback save_notepad_file_path(string);
    callback open_notepad_file(string);
    callback open_extension_file(string);
    callback open_extensions_guide();
    callback toggle_extension_item(string, bool);
    callback remove_extension_item(string);
    callback restore_builtin_notepad();
    callback add_custom_extension(string, string, string, string);

    callback move_category(int, int);
    callback reset_category_order();
    callback toggle_app_item(string, bool);
    callback add_scan_path(string);
    callback remove_scan_path(int);
    callback save_system_paths(string, string);
    callback add_custom_command(string, string);
    callback remove_custom_command(int);
    callback add_custom_setting(string, string);
    callback remove_custom_setting(int);
    callback add_bang_rule(string, string);
    callback remove_bang_rule(string);
    callback reload_all();

    VerticalLayout {
        padding: 16px;
        spacing: 12px;

        HorizontalLayout {
            height: 34px;
            spacing: 10px;

            Text {
                text: "⚙ Command Palette Settings (CmdPal)";
                color: root.theme_text_primary;
                font-size: 18px;
                font-weight: 700;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }

            if root.status_message != "" : Text {
                text: root.status_message;
                color: root.theme_accent;
                font-size: 12px;
                vertical-alignment: center;
            }

            Rectangle {
                width: 175px;
                height: 30px;
                border-radius: 6px;
                background: top_guide_touch.has-hover ? root.theme_selected_bg : root.theme_surface_bg;
                border-color: root.theme_accent;
                border-width: 1px;

                Text {
                    text: "📖 Open Extensions Guide";
                    color: root.theme_accent;
                    font-size: 12px;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                top_guide_touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.open_extensions_guide();
                    }
                }
            }

            Rectangle {
                width: 115px;
                height: 30px;
                border-radius: 6px;
                background: reload_touch.has-hover ? root.theme_selected_bg : root.theme_surface_bg;
                border-color: root.theme_border;
                border-width: 1px;

                Text {
                    text: "↻ Rescan All";
                    color: root.theme_text_primary;
                    font-size: 12px;
                    font-weight: 600;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                reload_touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.reload_all();
                    }
                }
            }
        }

        // 7-Tab Navigation Bar
        HorizontalLayout {
            height: 34px;
            spacing: 5px;

            for tab_item[idx] in [
                "1. General & Theme",
                "2. Order",
                "3. System Cmds",
                "4. Win Settings",
                "5. Apps & Files",
                "6. Extensions (Note)",
                "7. Web & Search"
            ] : Rectangle {
                horizontal-stretch: 1;
                border-radius: 6px;
                background: root.active_tab == idx
                    ? root.theme_accent
                    : (tab_touch.has-hover ? root.theme_selected_bg : root.theme_surface_bg);
                border-color: root.theme_border;
                border-width: 1px;

                Text {
                    text: tab_item;
                    color: root.active_tab == idx ? #121212 : root.theme_text_primary;
                    font-size: 11px;
                    font-weight: root.active_tab == idx ? 700 : 500;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                tab_touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.active_tab = idx;
                    }
                }
            }
        }

        // TAB 0: General & Theme
        if root.active_tab == 0 : Flickable {
            vertical-stretch: 1;

            VerticalLayout {
                spacing: 10px;

                Rectangle {
                    height: 52px;
                    border-radius: 8px;
                    background: root.theme_card_bg;
                    border-color: root.theme_border;
                    border-width: 1px;

                    HorizontalLayout {
                        padding: 12px;
                        spacing: 12px;

                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            Text {
                                text: "Show Command Palette's Own Shortcuts in Search (CmdPal Category)";
                                color: root.theme_text_primary;
                                font-size: 13px;
                                font-weight: 600;
                            }
                            Text {
                                text: "Separates CmdPal settings from Windows System Settings in the palette";
                                color: root.theme_text_muted;
                                font-size: 11px;
                            }
                        }

                        Rectangle {
                            width: 66px;
                            height: 28px;
                            border-radius: 14px;
                            background: root.enable_cmdpal_shortcuts ? root.theme_accent : root.theme_selected_bg;

                            Text {
                                text: root.enable_cmdpal_shortcuts ? "ON" : "OFF";
                                color: root.enable_cmdpal_shortcuts ? #121212 : root.theme_text_primary;
                                font-size: 11px;
                                font-weight: 700;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.enable_cmdpal_shortcuts = !root.enable_cmdpal_shortcuts;
                                    root.toggle_cmdpal_shortcuts(root.enable_cmdpal_shortcuts);
                                }
                            }
                        }
                    }
                }

                Rectangle {
                    height: 52px;
                    border-radius: 8px;
                    background: root.theme_card_bg;
                    border-color: root.theme_border;
                    border-width: 1px;

                    HorizontalLayout {
                        padding: 12px;
                        spacing: 12px;

                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            Text {
                                text: "Run Command Palette on Windows Startup";
                                color: root.theme_text_primary;
                                font-size: 13px;
                                font-weight: 600;
                            }
                            Text {
                                text: "Automatically start in the system tray when signing into Windows";
                                color: root.theme_text_muted;
                                font-size: 11px;
                            }
                        }

                        Rectangle {
                            width: 66px;
                            height: 28px;
                            border-radius: 14px;
                            background: root.run_on_startup ? root.theme_accent : root.theme_selected_bg;

                            Text {
                                text: root.run_on_startup ? "ON" : "OFF";
                                color: root.run_on_startup ? #121212 : root.theme_text_primary;
                                font-size: 11px;
                                font-weight: 700;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.run_on_startup = !root.run_on_startup;
                                    root.toggle_startup(root.run_on_startup);
                                }
                            }
                        }
                    }
                }

                Rectangle {
                    height: 82px;
                    border-radius: 8px;
                    background: root.theme_card_bg;
                    border-color: root.theme_border;
                    border-width: 1px;

                    VerticalLayout {
                        padding: 12px;
                        spacing: 8px;

                        Text {
                            text: "Global Activation Hotkey (Current: " + root.hotkey + ")";
                            color: root.theme_text_primary;
                            font-size: 13px;
                            font-weight: 600;
                        }

                        HorizontalLayout {
                            spacing: 8px;

                            for preset in ["Ctrl+Space", "Alt+Space", "Ctrl+Shift+Space", "Ctrl+Alt+Space", "Alt+Q"] : Rectangle {
                                horizontal-stretch: 1;
                                height: 28px;
                                border-radius: 6px;
                                background: root.hotkey == preset ? root.theme_accent : root.theme_surface_bg;
                                border-color: root.theme_border;
                                border-width: 1px;

                                Text {
                                    text: preset;
                                    color: root.hotkey == preset ? #121212 : root.theme_text_primary;
                                    font-size: 11px;
                                    font-weight: root.hotkey == preset ? 700 : 500;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }

                                TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.hotkey = preset;
                                        root.select_hotkey(preset);
                                    }
                                }
                            }
                        }
                    }
                }

                Rectangle {
                    height: 82px;
                    border-radius: 8px;
                    background: root.theme_card_bg;
                    border-color: root.theme_border;
                    border-width: 1px;

                    VerticalLayout {
                        padding: 12px;
                        spacing: 8px;

                        Text {
                            text: "Appearance Theme Mode";
                            color: root.theme_text_primary;
                            font-size: 13px;
                            font-weight: 600;
                        }

                        HorizontalLayout {
                            spacing: 10px;

                            Rectangle {
                                horizontal-stretch: 1;
                                height: 30px;
                                border-radius: 6px;
                                background: root.theme_mode == "powertoys" ? root.theme_accent : root.theme_surface_bg;
                                border-color: root.theme_border;
                                border-width: 1px;

                                Text {
                                    text: "Default (PowerToys Fluent Dark)";
                                    color: root.theme_mode == "powertoys" ? #121212 : root.theme_text_primary;
                                    font-size: 12px;
                                    font-weight: 700;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }

                                TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.theme_mode = "powertoys";
                                        root.select_theme_mode("powertoys");
                                    }
                                }
                            }

                            Rectangle {
                                horizontal-stretch: 1;
                                height: 30px;
                                border-radius: 6px;
                                background: root.theme_mode == "custom" ? root.theme_accent : root.theme_surface_bg;
                                border-color: root.theme_border;
                                border-width: 1px;

                                Text {
                                    text: "Custom Hex Theme";
                                    color: root.theme_mode == "custom" ? #121212 : root.theme_text_primary;
                                    font-size: 12px;
                                    font-weight: 700;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }

                                TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.theme_mode = "custom";
                                        root.select_theme_mode("custom");
                                    }
                                }
                            }
                        }
                    }
                }

                Rectangle {
                    height: 210px;
                    border-radius: 8px;
                    background: root.theme_card_bg;
                    border-color: root.theme_border;
                    border-width: 1px;

                    VerticalLayout {
                        padding: 12px;
                        spacing: 8px;

                        Text {
                            text: "Custom Theme Hex Colors (#RRGGBB)";
                            color: root.theme_text_primary;
                            font-size: 13px;
                            font-weight: 600;
                        }

                        HorizontalLayout {
                            spacing: 8px;
                            VerticalLayout {
                                horizontal-stretch: 1;
                                Text { text: "Window BG"; color: root.theme_text_muted; font-size: 11px; }
                                Rectangle {
                                    height: 28px; border-radius: 5px; background: root.theme_surface_bg; border-color: root.theme_border; border-width: 1px;
                                    TextInput { width: 100%; height: 100%; text <=> root.custom_window_bg; color: root.theme_text_primary; font-size: 12px; vertical-alignment: center; single-line: true; }
                                }
                            }
                            VerticalLayout {
                                horizontal-stretch: 1;
                                Text { text: "Surface BG"; color: root.theme_text_muted; font-size: 11px; }
                                Rectangle {
                                    height: 28px; border-radius: 5px; background: root.theme_surface_bg; border-color: root.theme_border; border-width: 1px;
                                    TextInput { width: 100%; height: 100%; text <=> root.custom_surface_bg; color: root.theme_text_primary; font-size: 12px; vertical-alignment: center; single-line: true; }
                                }
                            }
                            VerticalLayout {
                                horizontal-stretch: 1;
                                Text { text: "Card BG"; color: root.theme_text_muted; font-size: 11px; }
                                Rectangle {
                                    height: 28px; border-radius: 5px; background: root.theme_surface_bg; border-color: root.theme_border; border-width: 1px;
                                    TextInput { width: 100%; height: 100%; text <=> root.custom_card_bg; color: root.theme_text_primary; font-size: 12px; vertical-alignment: center; single-line: true; }
                                }
                            }
                            VerticalLayout {
                                horizontal-stretch: 1;
                                Text { text: "Selected BG"; color: root.theme_text_muted; font-size: 11px; }
                                Rectangle {
                                    height: 28px; border-radius: 5px; background: root.theme_surface_bg; border-color: root.theme_border; border-width: 1px;
                                    TextInput { width: 100%; height: 100%; text <=> root.custom_selected_bg; color: root.theme_text_primary; font-size: 12px; vertical-alignment: center; single-line: true; }
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: 8px;
                            VerticalLayout {
                                horizontal-stretch: 1;
                                Text { text: "Border"; color: root.theme_text_muted; font-size: 11px; }
                                Rectangle {
                                    height: 28px; border-radius: 5px; background: root.theme_surface_bg; border-color: root.theme_border; border-width: 1px;
                                    TextInput { width: 100%; height: 100%; text <=> root.custom_border; color: root.theme_text_primary; font-size: 12px; vertical-alignment: center; single-line: true; }
                                }
                            }
                            VerticalLayout {
                                horizontal-stretch: 1;
                                Text { text: "Accent"; color: root.theme_text_muted; font-size: 11px; }
                                Rectangle {
                                    height: 28px; border-radius: 5px; background: root.theme_surface_bg; border-color: root.theme_border; border-width: 1px;
                                    TextInput { width: 100%; height: 100%; text <=> root.custom_accent; color: root.theme_text_primary; font-size: 12px; vertical-alignment: center; single-line: true; }
                                }
                            }
                            VerticalLayout {
                                horizontal-stretch: 1;
                                Text { text: "Primary Text"; color: root.theme_text_muted; font-size: 11px; }
                                Rectangle {
                                    height: 28px; border-radius: 5px; background: root.theme_surface_bg; border-color: root.theme_border; border-width: 1px;
                                    TextInput { width: 100%; height: 100%; text <=> root.custom_text_primary; color: root.theme_text_primary; font-size: 12px; vertical-alignment: center; single-line: true; }
                                }
                            }
                            VerticalLayout {
                                horizontal-stretch: 1;
                                Text { text: "Muted Text"; color: root.theme_text_muted; font-size: 11px; }
                                Rectangle {
                                    height: 28px; border-radius: 5px; background: root.theme_surface_bg; border-color: root.theme_border; border-width: 1px;
                                    TextInput { width: 100%; height: 100%; text <=> root.custom_text_muted; color: root.theme_text_primary; font-size: 12px; vertical-alignment: center; single-line: true; }
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: 10px;
                            Rectangle {
                                horizontal-stretch: 1;
                                height: 30px;
                                border-radius: 6px;
                                background: root.theme_accent;
                                Text {
                                    text: "Save & Apply Custom Theme";
                                    color: #121212;
                                    font-size: 12px;
                                    font-weight: 700;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                                TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.apply_custom_theme(
                                            root.custom_window_bg,
                                            root.custom_surface_bg,
                                            root.custom_card_bg,
                                            root.custom_selected_bg,
                                            root.custom_border,
                                            root.custom_accent,
                                            root.custom_text_primary,
                                            root.custom_text_muted
                                        );
                                    }
                                }
                            }
                            Rectangle {
                                width: 180px;
                                height: 30px;
                                border-radius: 6px;
                                background: root.theme_surface_bg;
                                border-color: root.theme_border;
                                border-width: 1px;
                                Text {
                                    text: "Reset PowerToys Colors";
                                    color: root.theme_text_primary;
                                    font-size: 12px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                                TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.reset_custom_theme();
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        // TAB 1: Category Display Order
        if root.active_tab == 1 : VerticalLayout {
            vertical-stretch: 1;
            spacing: 10px;

            HorizontalLayout {
                height: 32px;
                spacing: 10px;

                Text {
                    text: "Arrange Shelf Category Priority (CmdPal Settings & Windows Settings are now separate!)";
                    color: root.theme_text_muted;
                    font-size: 12px;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }

                Rectangle {
                    width: 140px;
                    height: 30px;
                    border-radius: 6px;
                    background: root.theme_surface_bg;
                    border-color: root.theme_border;
                    border-width: 1px;

                    Text {
                        text: "Reset Default Order";
                        color: root.theme_text_primary;
                        font-size: 12px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.reset_category_order();
                        }
                    }
                }
            }

            Flickable {
                vertical-stretch: 1;

                VerticalLayout {
                    spacing: 6px;

                    for cat[idx] in root.category_entries : Rectangle {
                        height: 50px;
                        border-radius: 8px;
                        background: root.theme_card_bg;
                        border-color: root.theme_border;
                        border-width: 1px;

                        HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 14px;
                            spacing: 12px;

                            Text {
                                text: (idx + 1) + ".";
                                color: root.theme_accent;
                                font-size: 14px;
                                font-weight: 700;
                                vertical-alignment: center;
                                width: 22px;
                            }

                            Text {
                                text: cat.icon;
                                color: root.theme_text_primary;
                                font-size: 16px;
                                vertical-alignment: center;
                                width: 24px;
                            }

                            VerticalLayout {
                                horizontal-stretch: 1;
                                alignment: center;
                                Text {
                                    text: cat.display_name;
                                    color: root.theme_text_primary;
                                    font-size: 13px;
                                    font-weight: 600;
                                }
                                Text {
                                    text: cat.description;
                                    color: root.theme_text_muted;
                                    font-size: 11px;
                                    overflow: elide;
                                }
                            }

                            Rectangle {
                                width: 34px;
                                height: 28px;
                                y: (parent.height - self.height) / 2;
                                border-radius: 5px;
                                background: idx > 0 ? root.theme_surface_bg : transparent;
                                border-color: root.theme_border;
                                border-width: idx > 0 ? 1px : 0px;

                                Text {
                                    text: "▲";
                                    color: idx > 0 ? root.theme_text_primary : root.theme_text_muted;
                                    font-size: 12px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }

                                TouchArea {
                                    enabled: idx > 0;
                                    mouse-cursor: idx > 0 ? pointer : default;
                                    clicked => {
                                        root.move_category(idx, -1);
                                    }
                                }
                            }

                            Rectangle {
                                width: 34px;
                                height: 28px;
                                y: (parent.height - self.height) / 2;
                                border-radius: 5px;
                                background: idx < (root.category_entries.length - 1) ? root.theme_surface_bg : transparent;
                                border-color: root.theme_border;
                                border-width: idx < (root.category_entries.length - 1) ? 1px : 0px;

                                Text {
                                    text: "▼";
                                    color: idx < (root.category_entries.length - 1) ? root.theme_text_primary : root.theme_text_muted;
                                    font-size: 12px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }

                                TouchArea {
                                    enabled: idx < (root.category_entries.length - 1);
                                    mouse-cursor: idx < (root.category_entries.length - 1) ? pointer : default;
                                    clicked => {
                                        root.move_category(idx, 1);
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        // TAB 2: System Commands (Inbuilt Toggleable + Custom Commands)
        if root.active_tab == 2 : VerticalLayout {
            vertical-stretch: 1;
            spacing: 10px;

            Rectangle {
                height: 48px;
                border-radius: 8px;
                background: root.theme_card_bg;
                border-color: root.theme_border;
                border-width: 1px;

                HorizontalLayout {
                    padding: 10px;
                    spacing: 10px;

                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: center;
                        Text {
                            text: "Enable Inbuilt System Command Shortcuts (Task Manager, Lock, Restart, etc.)";
                            color: root.theme_text_primary;
                            font-size: 13px;
                            font-weight: 600;
                        }
                        Text {
                            text: "Toggle all inbuilt commands below or enable/disable individual shortcuts";
                            color: root.theme_text_muted;
                            font-size: 11px;
                        }
                    }

                    Rectangle {
                        width: 68px;
                        height: 28px;
                        border-radius: 14px;
                        background: root.enable_builtin_cmds ? root.theme_accent : root.theme_selected_bg;

                        Text {
                            text: root.enable_builtin_cmds ? "ALL ON" : "OFF";
                            color: root.enable_builtin_cmds ? #121212 : root.theme_text_primary;
                            font-size: 11px;
                            font-weight: 700;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.enable_builtin_cmds = !root.enable_builtin_cmds;
                                root.toggle_all_builtin_cmds(root.enable_builtin_cmds);
                            }
                        }
                    }
                }
            }

            Text {
                text: "Inbuilt System Commands (Click ON/OFF to enable or disable individual shortcuts):";
                color: root.theme_text_muted;
                font-size: 11px;
            }

            Flickable {
                height: 185px;

                VerticalLayout {
                    spacing: 4px;

                    for item in root.builtin_cmd_entries : Rectangle {
                        height: 36px;
                        border-radius: 6px;
                        background: root.theme_card_bg;
                        border-color: root.theme_border;
                        border-width: 1px;

                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            spacing: 10px;

                            Text {
                                text: item.title;
                                color: root.theme_text_primary;
                                font-size: 12px;
                                font-weight: 600;
                                vertical-alignment: center;
                                width: 220px;
                                overflow: elide;
                            }

                            Text {
                                text: item.subtitle;
                                color: root.theme_text_muted;
                                font-size: 11px;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                                overflow: elide;
                            }

                            Rectangle {
                                width: 58px;
                                height: 24px;
                                y: (parent.height - self.height) / 2;
                                border-radius: 12px;
                                background: item.enabled ? root.theme_accent : root.theme_selected_bg;

                                Text {
                                    text: item.enabled ? "ON" : "OFF";
                                    color: item.enabled ? #121212 : root.theme_text_primary;
                                    font-size: 11px;
                                    font-weight: 700;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }

                                TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.toggle_builtin_cmd_item(item.id, !item.enabled);
                                    }
                                }
                            }
                        }
                    }
                }
            }

            Rectangle {
                height: 76px;
                border-radius: 8px;
                background: root.theme_card_bg;
                border-color: root.theme_border;
                border-width: 1px;

                VerticalLayout {
                    padding: 10px;
                    spacing: 6px;

                    Text {
                        text: "Add Custom Shell Command & Default Shell Runner (" + root.custom_cmd_path + ")";
                        color: root.theme_text_primary;
                        font-size: 12px;
                        font-weight: 600;
                    }

                    HorizontalLayout {
                        spacing: 8px;

                        Rectangle {
                            width: 170px;
                            height: 28px;
                            border-radius: 6px;
                            background: root.theme_surface_bg;
                            border-color: root.theme_border;
                            border-width: 1px;
                            HorizontalLayout {
                                padding-left: 8px;
                                TextInput {
                                    width: 100%; height: 100%;
                                    text <=> root.new_cmd_name;
                                    color: root.theme_text_primary;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                    single-line: true;
                                }
                            }
                        }

                        Rectangle {
                            horizontal-stretch: 1;
                            height: 28px;
                            border-radius: 6px;
                            background: root.theme_surface_bg;
                            border-color: root.theme_border;
                            border-width: 1px;
                            HorizontalLayout {
                                padding-left: 8px;
                                TextInput {
                                    width: 100%; height: 100%;
                                    text <=> root.new_cmd_exec;
                                    color: root.theme_text_primary;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                    single-line: true;
                                }
                            }
                        }

                        Rectangle {
                            width: 110px;
                            height: 28px;
                            border-radius: 6px;
                            background: root.theme_accent;
                            Text {
                                text: "+ Add Cmd";
                                color: #121212;
                                font-size: 12px;
                                font-weight: 700;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.add_custom_command(root.new_cmd_name, root.new_cmd_exec);
                                    root.new_cmd_name = "";
                                    root.new_cmd_exec = "";
                                }
                            }
                        }
                    }
                }
            }

            Flickable {
                vertical-stretch: 1;

                VerticalLayout {
                    spacing: 4px;

                    for cmd[idx] in root.custom_commands : Rectangle {
                        height: 36px;
                        border-radius: 6px;
                        background: root.theme_card_bg;
                        border-color: root.theme_border;
                        border-width: 1px;

                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            spacing: 10px;

                            Text {
                                text: cmd.name;
                                color: root.theme_accent;
                                font-size: 12px;
                                font-weight: 700;
                                vertical-alignment: center;
                                width: 180px;
                                overflow: elide;
                            }

                            Text {
                                text: cmd.command;
                                color: root.theme_text_muted;
                                font-size: 11px;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                                overflow: elide;
                            }

                            Rectangle {
                                width: 68px;
                                height: 24px;
                                y: (parent.height - self.height) / 2;
                                border-radius: 5px;
                                background: #442726;

                                Text {
                                    text: "Remove";
                                    color: #ff99a4;
                                    font-size: 11px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }

                                TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.remove_custom_command(idx);
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        // TAB 3: Windows System Settings (Inbuilt Toggleable + Custom Settings)
        if root.active_tab == 3 : VerticalLayout {
            vertical-stretch: 1;
            spacing: 10px;

            Rectangle {
                height: 48px;
                border-radius: 8px;
                background: root.theme_card_bg;
                border-color: root.theme_border;
                border-width: 1px;

                HorizontalLayout {
                    padding: 10px;
                    spacing: 10px;

                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: center;
                        Text {
                            text: "Enable Inbuilt Windows System Settings Shortcuts (ms-settings:)";
                            color: root.theme_text_primary;
                            font-size: 13px;
                            font-weight: 600;
                        }
                        Text {
                            text: "Shown under 'WINDOWS SYSTEM SETTINGS' (separate from CmdPal's own settings)";
                            color: root.theme_text_muted;
                            font-size: 11px;
                        }
                    }

                    Rectangle {
                        width: 68px;
                        height: 28px;
                        border-radius: 14px;
                        background: root.enable_builtin_settings ? root.theme_accent : root.theme_selected_bg;

                        Text {
                            text: root.enable_builtin_settings ? "ALL ON" : "OFF";
                            color: root.enable_builtin_settings ? #121212 : root.theme_text_primary;
                            font-size: 11px;
                            font-weight: 700;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.enable_builtin_settings = !root.enable_builtin_settings;
                                root.toggle_all_builtin_settings(root.enable_builtin_settings);
                            }
                        }
                    }
                }
            }

            Text {
                text: "Inbuilt Windows Settings Shortcuts (Click ON/OFF to enable or disable individual items):";
                color: root.theme_text_muted;
                font-size: 11px;
            }

            Flickable {
                height: 195px;

                VerticalLayout {
                    spacing: 4px;

                    for item in root.builtin_setting_entries : Rectangle {
                        height: 36px;
                        border-radius: 6px;
                        background: root.theme_card_bg;
                        border-color: root.theme_border;
                        border-width: 1px;

                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            spacing: 10px;

                            Text {
                                text: item.title;
                                color: root.theme_text_primary;
                                font-size: 12px;
                                font-weight: 600;
                                vertical-alignment: center;
                                width: 225px;
                                overflow: elide;
                            }

                            Text {
                                text: item.subtitle;
                                color: root.theme_text_muted;
                                font-size: 11px;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                                overflow: elide;
                            }

                            Rectangle {
                                width: 58px;
                                height: 24px;
                                y: (parent.height - self.height) / 2;
                                border-radius: 12px;
                                background: item.enabled ? root.theme_accent : root.theme_selected_bg;

                                Text {
                                    text: item.enabled ? "ON" : "OFF";
                                    color: item.enabled ? #121212 : root.theme_text_primary;
                                    font-size: 11px;
                                    font-weight: 700;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }

                                TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.toggle_builtin_setting_item(item.id, !item.enabled);
                                    }
                                }
                            }
                        }
                    }
                }
            }

            Rectangle {
                height: 76px;
                border-radius: 8px;
                background: root.theme_card_bg;
                border-color: root.theme_border;
                border-width: 1px;

                VerticalLayout {
                    padding: 10px;
                    spacing: 6px;

                    Text {
                        text: "Add Custom Windows Setting URI or Control Panel Applet";
                        color: root.theme_text_primary;
                        font-size: 12px;
                        font-weight: 600;
                    }

                    HorizontalLayout {
                        spacing: 8px;

                        Rectangle {
                            width: 190px;
                            height: 28px;
                            border-radius: 6px;
                            background: root.theme_surface_bg;
                            border-color: root.theme_border;
                            border-width: 1px;
                            HorizontalLayout {
                                padding-left: 8px;
                                TextInput {
                                    width: 100%; height: 100%;
                                    text <=> root.new_setting_name;
                                    color: root.theme_text_primary;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                    single-line: true;
                                }
                            }
                        }

                        Rectangle {
                            horizontal-stretch: 1;
                            height: 28px;
                            border-radius: 6px;
                            background: root.theme_surface_bg;
                            border-color: root.theme_border;
                            border-width: 1px;
                            HorizontalLayout {
                                padding-left: 8px;
                                TextInput {
                                    width: 100%; height: 100%;
                                    text <=> root.new_setting_path;
                                    color: root.theme_text_primary;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                    single-line: true;
                                }
                            }
                        }

                        Rectangle {
                            width: 115px;
                            height: 28px;
                            border-radius: 6px;
                            background: root.theme_accent;
                            Text {
                                text: "+ Add Setting";
                                color: #121212;
                                font-size: 12px;
                                font-weight: 700;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.add_custom_setting(root.new_setting_name, root.new_setting_path);
                                    root.new_setting_name = "";
                                    root.new_setting_path = "";
                                }
                            }
                        }
                    }
                }
            }

            Flickable {
                vertical-stretch: 1;

                VerticalLayout {
                    spacing: 4px;

                    for st[idx] in root.custom_settings : Rectangle {
                        height: 36px;
                        border-radius: 6px;
                        background: root.theme_card_bg;
                        border-color: root.theme_border;
                        border-width: 1px;

                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            spacing: 10px;

                            Text {
                                text: st.name;
                                color: root.theme_accent;
                                font-size: 12px;
                                font-weight: 700;
                                vertical-alignment: center;
                                width: 190px;
                                overflow: elide;
                            }

                            Text {
                                text: st.path;
                                color: root.theme_text_muted;
                                font-size: 11px;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                                overflow: elide;
                            }

                            Rectangle {
                                width: 68px;
                                height: 24px;
                                y: (parent.height - self.height) / 2;
                                border-radius: 5px;
                                background: #442726;

                                Text {
                                    text: "Remove";
                                    color: #ff99a4;
                                    font-size: 11px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }

                                TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.remove_custom_setting(idx);
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        // TAB 4: Installed Apps & Custom File Scan Paths
        if root.active_tab == 4 : VerticalLayout {
            vertical-stretch: 1;
            spacing: 10px;

            HorizontalLayout {
                height: 34px;
                spacing: 10px;

                Text {
                    text: "Show Installed Start Menu Applications in Suggestions:";
                    color: root.theme_text_primary;
                    font-size: 13px;
                    font-weight: 600;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }

                Rectangle {
                    width: 68px;
                    height: 28px;
                    border-radius: 14px;
                    background: root.show_apps ? root.theme_accent : root.theme_selected_bg;

                    Text {
                        text: root.show_apps ? "ON" : "OFF";
                        color: root.show_apps ? #121212 : root.theme_text_primary;
                        font-size: 11px;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.show_apps = !root.show_apps;
                            root.toggle_show_apps(root.show_apps);
                        }
                    }
                }
            }

            Flickable {
                height: 210px;

                VerticalLayout {
                    spacing: 4px;

                    for app in root.app_entries : Rectangle {
                        height: 38px;
                        border-radius: 6px;
                        background: root.theme_card_bg;
                        border-color: root.theme_border;
                        border-width: 1px;

                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            spacing: 10px;

                            VerticalLayout {
                                horizontal-stretch: 1;
                                alignment: center;
                                Text {
                                    text: app.name;
                                    color: root.theme_text_primary;
                                    font-size: 12px;
                                    font-weight: 600;
                                    overflow: elide;
                                }
                                Text {
                                    text: app.path;
                                    color: root.theme_text_muted;
                                    font-size: 10px;
                                    overflow: elide;
                                }
                            }

                            Rectangle {
                                width: 64px;
                                height: 24px;
                                y: (parent.height - self.height) / 2;
                                border-radius: 12px;
                                background: app.enabled ? root.theme_accent : root.theme_selected_bg;

                                Text {
                                    text: app.enabled ? "SHOWN" : "HIDDEN";
                                    color: app.enabled ? #121212 : root.theme_text_primary;
                                    font-size: 10px;
                                    font-weight: 700;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }

                                TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.toggle_app_item(app.name, !app.enabled);
                                    }
                                }
                            }
                        }
                    }
                }
            }

            HorizontalLayout {
                height: 32px;
                spacing: 8px;

                Rectangle {
                    horizontal-stretch: 1;
                    border-radius: 6px;
                    background: root.theme_surface_bg;
                    border-color: root.theme_border;
                    border-width: 1px;

                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        TextInput {
                            width: 100%; height: 100%;
                            text <=> root.new_scan_path;
                            color: root.theme_text_primary;
                            font-size: 12px;
                            vertical-alignment: center;
                            single-line: true;
                        }
                    }
                }

                Rectangle {
                    width: 145px;
                    border-radius: 6px;
                    background: root.theme_accent;

                    Text {
                        text: "+ Add Scan Path";
                        color: #121212;
                        font-size: 12px;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.add_scan_path(root.new_scan_path);
                            root.new_scan_path = "";
                        }
                    }
                }
            }

            Flickable {
                vertical-stretch: 1;

                VerticalLayout {
                    spacing: 4px;

                    for scan_path[idx] in root.file_scan_paths : Rectangle {
                        height: 36px;
                        border-radius: 6px;
                        background: root.theme_card_bg;
                        border-color: root.theme_border;
                        border-width: 1px;

                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            spacing: 10px;

                            Text {
                                text: scan_path;
                                color: root.theme_text_primary;
                                font-size: 12px;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                                overflow: elide;
                            }

                            Rectangle {
                                width: 68px;
                                height: 24px;
                                y: (parent.height - self.height) / 2;
                                border-radius: 5px;
                                background: #442726;

                                Text {
                                    text: "Remove";
                                    color: #ff99a4;
                                    font-size: 11px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }

                                TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.remove_scan_path(idx);
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        // TAB 5: Extensions Manager (Includes 1-Click Open Guide & 1-Click Open .txt/.md Note File)
        if root.active_tab == 5 : VerticalLayout {
            vertical-stretch: 1;
            spacing: 10px;

            // Built-in Notepad Extension Configuration Card
            Rectangle {
                height: 92px;
                border-radius: 8px;
                background: root.theme_card_bg;
                border-color: root.theme_border;
                border-width: 1px;

                VerticalLayout {
                    padding: 12px;
                    spacing: 8px;

                    HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: "📝 Quick Notepad ('note' Bang) — Selected .txt or .md File:";
                            color: root.theme_text_primary;
                            font-size: 13px;
                            font-weight: 700;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }

                        if !root.notepad_installed : Rectangle {
                            width: 170px;
                            height: 26px;
                            border-radius: 6px;
                            background: root.theme_accent;

                            Text {
                                text: "+ Re-Add 'note' Extension";
                                color: #121212;
                                font-size: 11px;
                                font-weight: 700;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.restore_builtin_notepad();
                                }
                            }
                        }

                        Rectangle {
                            width: 185px;
                            height: 26px;
                            border-radius: 6px;
                            background: guide_btn_touch.has-hover ? root.theme_selected_bg : root.theme_surface_bg;
                            border-color: root.theme_accent;
                            border-width: 1px;

                            Text {
                                text: "📖 Open Extensions Guide";
                                color: root.theme_accent;
                                font-size: 11px;
                                font-weight: 700;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            guide_btn_touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.open_extensions_guide();
                                }
                            }
                        }
                    }

                    HorizontalLayout {
                        spacing: 6px;

                        Rectangle {
                            horizontal-stretch: 1;
                            height: 30px;
                            border-radius: 6px;
                            background: root.theme_surface_bg;
                            border-color: root.theme_border;
                            border-width: 1px;

                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                TextInput {
                                    width: 100%; height: 100%;
                                    text <=> root.notepad_file_path;
                                    color: root.theme_text_primary;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                    single-line: true;
                                }
                            }
                        }

                        for preset_file in ["notes.md", "notes.txt", "~/Desktop/notes.md"] : Rectangle {
                            width: 110px;
                            height: 30px;
                            border-radius: 6px;
                            background: root.notepad_file_path == preset_file ? root.theme_selected_bg : root.theme_surface_bg;
                            border-color: root.theme_border;
                            border-width: 1px;

                            Text {
                                text: preset_file;
                                color: root.theme_text_primary;
                                font-size: 11px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.notepad_file_path = preset_file;
                                    root.save_notepad_file_path(preset_file);
                                }
                            }
                        }

                        Rectangle {
                            width: 82px;
                            height: 30px;
                            border-radius: 6px;
                            background: root.theme_accent;

                            Text {
                                text: "Save File";
                                color: #121212;
                                font-size: 11px;
                                font-weight: 700;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.save_notepad_file_path(root.notepad_file_path);
                                }
                            }
                        }

                        Rectangle {
                            width: 125px;
                            height: 30px;
                            border-radius: 6px;
                            background: open_note_touch.has-hover ? root.theme_selected_bg : root.theme_surface_bg;
                            border-color: root.theme_accent;
                            border-width: 1px;

                            Text {
                                text: "📂 Open Note File";
                                color: root.theme_accent;
                                font-size: 11px;
                                font-weight: 700;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            open_note_touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.open_notepad_file(root.notepad_file_path);
                                }
                            }
                        }
                    }
                }
            }

            // Create / Add a New Extension Card
            Rectangle {
                height: 112px;
                border-radius: 8px;
                background: root.theme_card_bg;
                border-color: root.theme_border;
                border-width: 1px;

                VerticalLayout {
                    padding: 10px;
                    spacing: 8px;

                    HorizontalLayout {
                        spacing: 8px;

                        Text {
                            text: "Add New Extension — Choose Type:";
                            color: root.theme_text_primary;
                            font-size: 12px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }

                        for kind_opt in ["NotepadFile", "QuickAppendFile", "ShellCommand", "WebTemplate"] : Rectangle {
                            height: 24px;
                            horizontal-stretch: 1;
                            border-radius: 5px;
                            background: root.new_ext_kind == kind_opt ? root.theme_accent : root.theme_surface_bg;
                            border-color: root.theme_border;
                            border-width: 1px;

                            Text {
                                text: kind_opt;
                                color: root.new_ext_kind == kind_opt ? #121212 : root.theme_text_primary;
                                font-size: 11px;
                                font-weight: root.new_ext_kind == kind_opt ? 700 : 500;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.new_ext_kind = kind_opt;
                                }
                            }
                        }
                    }

                    HorizontalLayout {
                        spacing: 8px;

                        Rectangle {
                            width: 155px;
                            height: 30px;
                            border-radius: 6px;
                            background: root.theme_surface_bg;
                            border-color: root.theme_border;
                            border-width: 1px;
                            HorizontalLayout {
                                padding-left: 8px;
                                Text {
                                    visible: root.new_ext_name == "";
                                    text: "Extension Name";
                                    color: root.theme_text_muted;
                                    font-size: 11px;
                                    vertical-alignment: center;
                                }
                                TextInput {
                                    width: 100%; height: 100%;
                                    text <=> root.new_ext_name;
                                    color: root.theme_text_primary;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                    single-line: true;
                                }
                            }
                        }

                        Rectangle {
                            width: 105px;
                            height: 30px;
                            border-radius: 6px;
                            background: root.theme_surface_bg;
                            border-color: root.theme_border;
                            border-width: 1px;
                            HorizontalLayout {
                                padding-left: 8px;
                                Text {
                                    visible: root.new_ext_bang == "";
                                    text: "Bang (e.g. todo)";
                                    color: root.theme_text_muted;
                                    font-size: 11px;
                                    vertical-alignment: center;
                                }
                                TextInput {
                                    width: 100%; height: 100%;
                                    text <=> root.new_ext_bang;
                                    color: root.theme_text_primary;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                    single-line: true;
                                }
                            }
                        }

                        Rectangle {
                            horizontal-stretch: 1;
                            height: 30px;
                            border-radius: 6px;
                            background: root.theme_surface_bg;
                            border-color: root.theme_border;
                            border-width: 1px;
                            HorizontalLayout {
                                padding-left: 8px;
                                Text {
                                    visible: root.new_ext_target == "";
                                    text: root.new_ext_kind == "NotepadFile" || root.new_ext_kind == "QuickAppendFile"
                                        ? "Target .txt/.md path (e.g. todo.md)"
                                        : "Command or URL template with {q}";
                                    color: root.theme_text_muted;
                                    font-size: 11px;
                                    vertical-alignment: center;
                                }
                                TextInput {
                                    width: 100%; height: 100%;
                                    text <=> root.new_ext_target;
                                    color: root.theme_text_primary;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                    single-line: true;
                                }
                            }
                        }

                        Rectangle {
                            width: 125px;
                            height: 30px;
                            border-radius: 6px;
                            background: root.theme_accent;

                            Text {
                                text: "+ Add Extension";
                                color: #121212;
                                font-size: 12px;
                                font-weight: 700;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.add_custom_extension(
                                        root.new_ext_name,
                                        root.new_ext_bang,
                                        root.new_ext_kind,
                                        root.new_ext_target
                                    );
                                    root.new_ext_name = "";
                                    root.new_ext_bang = "";
                                    root.new_ext_target = "";
                                }
                            }
                        }
                    }
                }
            }

            Text {
                text: "Installed Extensions (Click '📂 Open File' to open any extension's .txt/.md file directly):";
                color: root.theme_text_muted;
                font-size: 11px;
            }

            Flickable {
                vertical-stretch: 1;

                VerticalLayout {
                    spacing: 6px;

                    for ext in root.extension_entries : Rectangle {
                        height: 48px;
                        border-radius: 8px;
                        background: root.theme_card_bg;
                        border-color: root.theme_border;
                        border-width: 1px;

                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            spacing: 10px;

                            Text {
                                text: ext.icon;
                                font-size: 16px;
                                vertical-alignment: center;
                                width: 24px;
                            }

                            VerticalLayout {
                                horizontal-stretch: 1;
                                alignment: center;
                                Text {
                                    text: ext.name + "  [Bang: '" + ext.bang + " ' • " + ext.kind + "]";
                                    color: root.theme_text_primary;
                                    font-size: 12px;
                                    font-weight: 700;
                                    overflow: elide;
                                }
                                Text {
                                    text: ext.target_meta;
                                    color: root.theme_text_muted;
                                    font-size: 11px;
                                    overflow: elide;
                                }
                            }

                            if ext.is_file_backed : Rectangle {
                                width: 92px;
                                height: 26px;
                                y: (parent.height - self.height) / 2;
                                border-radius: 6px;
                                background: row_open_file_touch.has-hover ? root.theme_selected_bg : root.theme_surface_bg;
                                border-color: root.theme_accent;
                                border-width: 1px;

                                Text {
                                    text: "📂 Open File";
                                    color: root.theme_accent;
                                    font-size: 11px;
                                    font-weight: 600;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }

                                row_open_file_touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.open_extension_file(ext.target_file);
                                    }
                                }
                            }

                            Rectangle {
                                width: 60px;
                                height: 26px;
                                y: (parent.height - self.height) / 2;
                                border-radius: 13px;
                                background: ext.enabled ? root.theme_accent : root.theme_selected_bg;

                                Text {
                                    text: ext.enabled ? "ON" : "OFF";
                                    color: ext.enabled ? #121212 : root.theme_text_primary;
                                    font-size: 11px;
                                    font-weight: 700;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }

                                TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.toggle_extension_item(ext.id, !ext.enabled);
                                    }
                                }
                            }

                            Rectangle {
                                width: 70px;
                                height: 26px;
                                y: (parent.height - self.height) / 2;
                                border-radius: 6px;
                                background: #442726;

                                Text {
                                    text: "Remove";
                                    color: #ff99a4;
                                    font-size: 11px;
                                    font-weight: 600;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }

                                TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.remove_extension_item(ext.id);
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        // TAB 6: Default Search Engine & Web Bangs
        if root.active_tab == 6 : VerticalLayout {
            vertical-stretch: 1;
            spacing: 10px;

            Rectangle {
                height: 125px;
                border-radius: 8px;
                background: root.theme_card_bg;
                border-color: root.theme_border;
                border-width: 1px;

                VerticalLayout {
                    padding: 12px;
                    spacing: 8px;

                    Text {
                        text: "Default Web Search Engine (Current: " + root.default_search_engine + ")";
                        color: root.theme_text_primary;
                        font-size: 13px;
                        font-weight: 700;
                    }

                    HorizontalLayout {
                        spacing: 6px;

                        for eng in [
                            { id: "google", label: "Google" },
                            { id: "duckduckgo", label: "DuckDuckGo" },
                            { id: "bing", label: "Bing" },
                            { id: "brave", label: "Brave" },
                            { id: "startpage", label: "Startpage" },
                            { id: "perplexity", label: "Perplexity" },
                            { id: "youtube", label: "YouTube" },
                            { id: "custom", label: "Custom URL" }
                        ] : Rectangle {
                            horizontal-stretch: 1;
                            height: 28px;
                            border-radius: 6px;
                            background: root.default_search_engine == eng.id ? root.theme_accent : root.theme_surface_bg;
                            border-color: root.theme_border;
                            border-width: 1px;

                            Text {
                                text: eng.label;
                                color: root.default_search_engine == eng.id ? #121212 : root.theme_text_primary;
                                font-size: 11px;
                                font-weight: root.default_search_engine == eng.id ? 700 : 500;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.default_search_engine = eng.id;
                                    root.select_default_search_engine(eng.id);
                                }
                            }
                        }
                    }

                    HorizontalLayout {
                        spacing: 8px;

                        Text {
                            text: "Custom URL ({q}):";
                            color: root.theme_text_muted;
                            font-size: 11px;
                            vertical-alignment: center;
                        }

                        Rectangle {
                            horizontal-stretch: 1;
                            height: 28px;
                            border-radius: 6px;
                            background: root.theme_surface_bg;
                            border-color: root.theme_border;
                            border-width: 1px;

                            HorizontalLayout {
                                padding-left: 8px;
                                TextInput {
                                    width: 100%; height: 100%;
                                    text <=> root.custom_search_url;
                                    color: root.theme_text_primary;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                    single-line: true;
                                }
                            }
                        }

                        Rectangle {
                            width: 125px;
                            height: 28px;
                            border-radius: 6px;
                            background: root.theme_accent;

                            Text {
                                text: "Save Custom URL";
                                color: #121212;
                                font-size: 11px;
                                font-weight: 700;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.save_custom_search_url(root.custom_search_url);
                                }
                            }
                        }
                    }
                }
            }

            HorizontalLayout {
                height: 34px;
                spacing: 8px;

                Rectangle {
                    width: 130px;
                    border-radius: 6px;
                    background: root.theme_surface_bg;
                    border-color: root.theme_border;
                    border-width: 1px;

                    HorizontalLayout {
                        padding-left: 10px;
                        Text {
                            visible: root.new_bang_trigger == "";
                            text: "Bang (e.g. yt)";
                            color: root.theme_text_muted;
                            font-size: 11px;
                            vertical-alignment: center;
                        }
                        TextInput {
                            width: 100%; height: 100%;
                            text <=> root.new_bang_trigger;
                            color: root.theme_text_primary;
                            font-size: 12px;
                            vertical-alignment: center;
                            single-line: true;
                        }
                    }
                }

                Rectangle {
                    horizontal-stretch: 1;
                    border-radius: 6px;
                    background: root.theme_surface_bg;
                    border-color: root.theme_border;
                    border-width: 1px;

                    HorizontalLayout {
                        padding-left: 10px;
                        Text {
                            visible: root.new_bang_url == "";
                            text: "https://example.com/search?q={q}";
                            color: root.theme_text_muted;
                            font-size: 11px;
                            vertical-alignment: center;
                        }
                        TextInput {
                            width: 100%; height: 100%;
                            text <=> root.new_bang_url;
                            color: root.theme_text_primary;
                            font-size: 12px;
                            vertical-alignment: center;
                            single-line: true;
                        }
                    }
                }

                Rectangle {
                    width: 120px;
                    border-radius: 6px;
                    background: root.theme_accent;

                    Text {
                        text: "+ Save Bang";
                        color: #121212;
                        font-size: 12px;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.add_bang_rule(root.new_bang_trigger, root.new_bang_url);
                            root.new_bang_trigger = "";
                            root.new_bang_url = "";
                        }
                    }
                }
            }

            Flickable {
                vertical-stretch: 1;

                VerticalLayout {
                    spacing: 4px;

                    for rule in root.bang_entries : Rectangle {
                        height: 38px;
                        border-radius: 6px;
                        background: root.theme_card_bg;
                        border-color: root.theme_border;
                        border-width: 1px;

                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            spacing: 12px;

                            Text {
                                text: rule.trigger;
                                color: root.theme_accent;
                                font-size: 13px;
                                font-weight: 700;
                                vertical-alignment: center;
                                width: 80px;
                            }

                            Text {
                                text: rule.url_template;
                                color: root.theme_text_muted;
                                font-size: 12px;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                                overflow: elide;
                            }

                            Rectangle {
                                width: 68px;
                                height: 24px;
                                y: (parent.height - self.height) / 2;
                                border-radius: 5px;
                                background: #442726;

                                Text {
                                    text: "Remove";
                                    color: #ff99a4;
                                    font-size: 11px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }

                                TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.remove_bang_rule(rule.trigger);
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
