import { ScrollView } from "std-widgets.slint";

export struct UIResultItem {
    title: string,
    badge: string,
    category: string,
    category-header: string,
    icon-text: string,
    can-elevate: bool,
    is-first-in-category: bool,
}

export struct UICategoryOrderItem {
    id: string,
    label: string,
    description: string,
}

export struct UIAppToggleItem {
    name: string,
    visible: bool,
}

export struct UISimpleEntry {
    name: string,
    target: string,
}

export struct UIBangEntry {
    key: string,
    url: string,
}

export struct UIThemeOption {
    id: string,
    name: string,
    subtitle: string,
    bg-preview: color,
    accent-preview: color,
}

struct ThemePalette {
    window-bg: color,
    surface-bg: color,
    card-bg: color,
    hover-bg: color,
    selected-bg: color,
    border: color,
    accent: color,
    text-primary: color,
    text-secondary: color,
    text-muted: color,
}

export component PaletteWindow inherits Window {
    title: "Command Palette";
    no-frame: true;
    always-on-top: true;
    background: transparent;
    width: 680px;
    height: root.dynamic-height;
    icon: root.app-icon;

    in property <image> app-icon;
    in-out property <string> theme-id: "midnight-indigo";
    in-out property <string> query-text: "";
    in-out property <[UIResultItem]> results: [];
    in-out property <int> selected-index: 0;
    in-out property <length> dynamic-height: 68px;
    in-out property <length> scroll-y: 0px;

    in-out property <bool> context-menu-visible: false;
    in-out property <int> context-menu-index: -1;
    in-out property <length> context-menu-x: 0px;
    in-out property <length> context-menu-y: 0px;
    in-out property <bool> context-menu-can-elevate: false;

    callback query-changed(string);
    callback activate-item(int);
    callback run-item-admin(int);
    callback open-settings();
    callback escape-pressed();

    pure function resolve-theme(id: string) -> ThemePalette {
        if (id == "catppuccin-mocha") {
            return {
                window-bg: #1e1e2e,
                surface-bg: #181825,
                card-bg: #313244,
                hover-bg: #2a2b3c,
                selected-bg: #3b3d54,
                border: #45475a,
                accent: #cba6f7,
                text-primary: #cdd6f4,
                text-secondary: #bac2de,
                text-muted: #7f849c,
            };
        }
        if (id == "tokyo-night") {
            return {
                window-bg: #1a1b26,
                surface-bg: #16161e,
                card-bg: #24283b,
                hover-bg: #202436,
                selected-bg: #2f3549,
                border: #3b4261,
                accent: #7aa2f7,
                text-primary: #c0caf5,
                text-secondary: #a9b1d6,
                text-muted: #565f89,
            };
        }
        if (id == "dracula") {
            return {
                window-bg: #282a36,
                surface-bg: #21222c,
                card-bg: #343746,
                hover-bg: #313442,
                selected-bg: #44475a,
                border: #6272a4,
                accent: #bd93f9,
                text-primary: #f8f8f2,
                text-secondary: #e2e2dc,
                text-muted: #6272a4,
            };
        }
        if (id == "nord-frost") {
            return {
                window-bg: #2e3440,
                surface-bg: #242933,
                card-bg: #3b4252,
                hover-bg: #353c4a,
                selected-bg: #434c5e,
                border: #4c566a,
                accent: #88c0d0,
                text-primary: #eceff4,
                text-secondary: #d8dee9,
                text-muted: #7b88a1,
            };
        }
        if (id == "gruvbox-dark") {
            return {
                window-bg: #282828,
                surface-bg: #1d2021,
                card-bg: #3c3836,
                hover-bg: #32302f,
                selected-bg: #504945,
                border: #665c54,
                accent: #fe8019,
                text-primary: #fbf1c7,
                text-secondary: #ebdbb2,
                text-muted: #a89984,
            };
        }
        if (id == "daylight-snow") {
            return {
                window-bg: #f8fafc,
                surface-bg: #ffffff,
                card-bg: #f1f5f9,
                hover-bg: #e2e8f0,
                selected-bg: #e0e7ff,
                border: #cbd5e1,
                accent: #4f46e5,
                text-primary: #0f172a,
                text-secondary: #334155,
                text-muted: #64748b,
            };
        }
        // Default: midnight-indigo
        return {
            window-bg: #11131a,
            surface-bg: #181b26,
            card-bg: #202434,
            hover-bg: #1a1e2e,
            selected-bg: #262c44,
            border: #2a2f42,
            accent: #6366f1,
            text-primary: #f3f4f8,
            text-secondary: #c7d2fe,
            text-muted: #6b728e,
        };
    }

    property <ThemePalette> theme: resolve-theme(root.theme-id);

    public function focus-input() {
        search-input.focus();
    }

    function sync-scroll-to-selection() {
        if (root.selected-index <= 1) {
            root.scroll-y = 0px;
        } else {
            let approx-y = root.selected-index * 46px;
            if (approx-y > 240px) {
                root.scroll-y = -(approx-y - 210px);
            }
        }
    }

    Rectangle {
        width: 100%;
        height: 100%;
        background: root.theme.window-bg;
        border-radius: 14px;
        border-width: 1px;
        border-color: root.theme.border;
        clip: true;

        VerticalLayout {
            padding: 10px;
            spacing: 8px;

            // Top Search Bar
            Rectangle {
                height: 48px;
                background: root.theme.surface-bg;
                border-radius: 10px;
                border-width: 1px;
                border-color: search-input.has-focus ? root.theme.accent : root.theme.border;

                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 10px;
                    spacing: 12px;
                    alignment: stretch;

                    VerticalLayout {
                        alignment: center;
                        width: 26px;
                        Image {
                            source: root.app-icon;
                            width: 24px;
                            height: 24px;
                        }
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                        clip: true;

                        if root.query-text == "" : Text {
                            x: 0px;
                            text: "Search commands, settings, apps, custom files, or web...";
                            color: root.theme.text-muted;
                            font-size: 15px;
                            vertical-alignment: center;
                            height: 100%;
                        }

                        search-input := TextInput {
                            width: 100%;
                            height: 100%;
                            text <=> root.query-text;
                            color: root.theme.text-primary;
                            font-size: 15px;
                            vertical-alignment: center;
                            single-line: true;

                            edited => {
                                root.context-menu-visible = false;
                                root.scroll-y = 0px;
                                root.query-changed(self.text);
                            }

                            accepted => {
                                if root.results.length > 0 && root.selected-index >= 0 {
                                    root.activate-item(root.selected-index);
                                }
                            }

                            key-pressed(event) => {
                                // Ctrl + Enter -> Run as Administrator
                                if (event.modifiers.control && event.text == Key.Return) {
                                    if (root.results.length > 0 && root.selected-index >= 0) {
                                        root.run-item-admin(root.selected-index);
                                    }
                                    return accept;
                                }
                                // Ctrl + , -> Open Settings GUI
                                if (event.modifiers.control && event.text == ",") {
                                    root.open-settings();
                                    return accept;
                                }
                                // DownArrow or Tab -> Next item (with wrap-around)
                                if (event.text == Key.DownArrow || (event.text == Key.Tab && !event.modifiers.shift)) {
                                    root.context-menu-visible = false;
                                    if (root.results.length > 0) {
                                        root.selected-index = Math.mod(root.selected-index + 1, root.results.length);
                                        root.sync-scroll-to-selection();
                                    }
                                    return accept;
                                }
                                // UpArrow or Shift+Tab -> Previous item (with wrap-around)
                                if (event.text == Key.UpArrow || (event.text == Key.Tab && event.modifiers.shift)) {
                                    root.context-menu-visible = false;
                                    if (root.results.length > 0) {
                                        root.selected-index = Math.mod(root.selected-index - 1 + root.results.length, root.results.length);
                                        root.sync-scroll-to-selection();
                                    }
                                    return accept;
                                }
                                // PageDown -> Jump 5 items forward
                                if (event.text == Key.PageDown) {
                                    root.context-menu-visible = false;
                                    if (root.results.length > 0) {
                                        root.selected-index = Math.min(root.selected-index + 5, root.results.length - 1);
                                        root.sync-scroll-to-selection();
                                    }
                                    return accept;
                                }
                                // PageUp -> Jump 5 items back
                                if (event.text == Key.PageUp) {
                                    root.context-menu-visible = false;
                                    if (root.results.length > 0) {
                                        root.selected-index = Math.max(root.selected-index - 5, 0);
                                        root.sync-scroll-to-selection();
                                    }
                                    return accept;
                                }
                                if (event.text == Key.Escape) {
                                    if (root.context-menu-visible) {
                                        root.context-menu-visible = false;
                                    } else {
                                        root.escape-pressed();
                                    }
                                    return accept;
                                }
                                return reject;
                            }
                        }
                    }

                    // Shortcut Pill
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            height: 24px;
                            width: 78px;
                            border-radius: 6px;
                            background: root.theme.card-bg;
                            border-width: 1px;
                            border-color: root.theme.border;

                            Text {
                                text: "Ctrl+Space";
                                color: root.theme.text-muted;
                                font-size: 10px;
                                font-weight: 600;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }

                    // Settings Gear Button
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 32px;
                            height: 30px;
                            border-radius: 7px;
                            background: settings-touch.has-hover ? root.theme.selected-bg : root.theme.card-bg;
                            border-width: 1px;
                            border-color: settings-touch.has-hover ? root.theme.accent : root.theme.border;

                            Text {
                                text: "⚙";
                                color: root.theme.text-primary;
                                font-size: 15px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            settings-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.open-settings();
                                }
                            }
                        }
                    }
                }
            }

            // Categorized Suggestion Results with Mouse & Keyboard Support
            if root.results.length > 0 : ScrollView {
                vertical-stretch: 1;
                width: 100%;
                content-y <=> root.scroll-y;

                VerticalLayout {
                    spacing: 3px;
                    padding-right: 4px;
                    alignment: start;

                    for item[index] in root.results : VerticalLayout {
                        spacing: 3px;

                        if item.is-first-in-category : Rectangle {
                            height: 24px;
                            background: transparent;

                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                alignment: start;

                                Text {
                                    text: item.category-header;
                                    color: root.theme.accent;
                                    font-size: 10px;
                                    font-weight: 800;
                                    letter-spacing: 0.8px;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        Rectangle {
                            height: 42px;
                            border-radius: 9px;
                            background: index == root.selected-index ? root.theme.selected-bg : (row-touch.has-hover ? root.theme.hover-bg : transparent);
                            border-width: index == root.selected-index ? 1px : 0px;
                            border-color: root.theme.accent;

                            row-touch := TouchArea {
                                width: 100%;
                                height: 100%;
                                mouse-cursor: pointer;

                                moved => {
                                    if (root.selected-index != index && !root.context-menu-visible) {
                                        root.selected-index = index;
                                    }
                                }

                                pointer-event(ev) => {
                                    if (ev.button == PointerEventButton.left && ev.kind == PointerEventKind.down) {
                                        root.context-menu-visible = false;
                                        root.selected-index = index;
                                        root.activate-item(index);
                                    } else if (ev.button == PointerEventButton.right && ev.kind == PointerEventKind.down) {
                                        root.selected-index = index;
                                        root.context-menu-index = index;
                                        root.context-menu-can-elevate = item.can-elevate;
                                        root.context-menu-x = Math.min(self.mouse-x + 16px, root.width - 220px);
                                        root.context-menu-y = Math.min(self.absolute-position.y - root.absolute-position.y + self.mouse-y, root.height - 80px);
                                        root.context-menu-visible = true;
                                    }
                                }
                            }

                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                spacing: 12px;
                                alignment: stretch;

                                // Left Category Icon Pill
                                VerticalLayout {
                                    alignment: center;
                                    Rectangle {
                                        width: 28px;
                                        height: 28px;
                                        border-radius: 7px;
                                        background: root.theme.card-bg;

                                        Text {
                                            text: item.icon-text;
                                            font-size: 13px;
                                            color: root.theme.accent;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                }

                                // Single-line Title (no paths below)
                                Text {
                                    horizontal-stretch: 1;
                                    text: item.title;
                                    color: root.theme.text-primary;
                                    font-size: 14px;
                                    font-weight: index == root.selected-index ? 600 : 500;
                                    overflow: elide;
                                    vertical-alignment: center;
                                }

                                // Category Badge
                                VerticalLayout {
                                    alignment: center;
                                    Rectangle {
                                        height: 22px;
                                        width: 68px;
                                        border-radius: 5px;
                                        background: root.theme.card-bg;

                                        Text {
                                            text: item.badge;
                                            color: index == root.selected-index ? root.theme.accent : root.theme.text-muted;
                                            font-size: 10px;
                                            font-weight: 700;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // Bottom Keyboard & Mouse Hint Footer
            if root.results.length > 0 : Rectangle {
                height: 26px;
                background: root.theme.surface-bg;
                border-radius: 7px;

                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 12px;
                    alignment: space-between;

                    Text {
                        text: "↑↓/Wheel Navigate  •  ↵/Click Open  •  Ctrl+↵ Admin  •  Ctrl+, Settings";
                        color: root.theme.text-muted;
                        font-size: 11px;
                        vertical-alignment: center;
                    }

                    Text {
                        text: (root.selected-index + 1) + " / " + root.results.length;
                        color: root.theme.text-muted;
                        font-size: 11px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // Right-Click Context Menu Overlay
        if root.context-menu-visible : TouchArea {
            width: 100%;
            height: 100%;
            clicked => {
                root.context-menu-visible = false;
            }

            Rectangle {
                x: root.context-menu-x;
                y: root.context-menu-y;
                width: 205px;
                height: root.context-menu-can-elevate ? 72px : 40px;
                background: root.theme.surface-bg;
                border-color: root.theme.border;
                border-width: 1px;
                border-radius: 8px;
                clip: true;

                VerticalLayout {
                    padding: 4px;
                    spacing: 2px;

                    Rectangle {
                        height: 30px;
                        border-radius: 5px;
                        background: open-item-touch.has-hover ? root.theme.selected-bg : transparent;

                        open-item-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.context-menu-visible = false;
                                root.activate-item(root.context-menu-index);
                            }
                        }

                        HorizontalLayout {
                            padding-left: 10px;
                            Text {
                                text: "▶  Open / Execute";
                                color: root.theme.text-primary;
                                font-size: 12px;
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                        }
                    }

                    if root.context-menu-can-elevate : Rectangle {
                        height: 30px;
                        border-radius: 5px;
                        background: admin-item-touch.has-hover ? root.theme.selected-bg : transparent;

                        admin-item-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.context-menu-visible = false;
                                root.run-item-admin(root.context-menu-index);
                            }
                        }

                        HorizontalLayout {
                            padding-left: 10px;
                            Text {
                                text: "⚡  Run as Administrator";
                                color: root.theme.accent;
                                font-size: 12px;
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }
    }
}

export component SettingsWindow inherits Window {
    title: "Command Palette Settings";
    width: 820px;
    height: 600px;
    background: root.theme.window-bg;
    icon: root.app-icon;

    in property <image> app-icon;
    in-out property <string> theme-id: "midnight-indigo";
    in-out property <int> active-tab: 0;
    in-out property <bool> show-apps: true;
    in-out property <string> custom-cmd-path: "cmd.exe";
    in-out property <string> custom-settings-path: "ms-settings:";

    in-out property <[UIThemeOption]> themes: [
        { id: "midnight-indigo", name: "Midnight Indigo", subtitle: "Deep obsidian with indigo glow", bg-preview: #11131a, accent-preview: #6366f1 },
        { id: "catppuccin-mocha", name: "Catppuccin Mocha", subtitle: "Soothing pastel mocha dark", bg-preview: #1e1e2e, accent-preview: #cba6f7 },
        { id: "tokyo-night", name: "Tokyo Night", subtitle: "Clean neon-blue downtown night", bg-preview: #1a1b26, accent-preview: #7aa2f7 },
        { id: "dracula", name: "Dracula", subtitle: "Classic high-contrast purple dark", bg-preview: #282a36, accent-preview: #bd93f9 },
        { id: "nord-frost", name: "Nord Frost", subtitle: "Arctic bluish-slate palette", bg-preview: #2e3440, accent-preview: #88c0d0 },
        { id: "gruvbox-dark", name: "Gruvbox Dark", subtitle: "Warm retrogroove amber dark", bg-preview: #282828, accent-preview: #fe8019 },
        { id: "daylight-snow", name: "Daylight Snow", subtitle: "Crisp high-contrast light mode", bg-preview: #f8fafc, accent-preview: #4f46e5 },
    ];

    in-out property <[UICategoryOrderItem]> category-order: [];
    in-out property <[UIAppToggleItem]> app-items: [];
    in-out property <[UISimpleEntry]> custom-commands: [];
    in-out property <[UISimpleEntry]> custom-settings: [];
    in-out property <[string]> custom-file-scan-paths: [];
    in-out property <int> indexed-files-count: 0;
    in-out property <[UIBangEntry]> bang-entries: [];
    in-out property <string> status-message: "";

    // Filter for Installed Apps tab
    in-out property <string> app-filter-text: "";

    // Simplified inputs for Tab 2 (Custom Commands)
    in-out property <string> new-cmd-name: "";
    in-out property <string> new-cmd-target: "";

    // Simplified inputs for Tab 3 (Custom Settings)
    in-out property <string> new-setting-name: "";
    in-out property <string> new-setting-path: "";

    // Input for Tab 4 (Custom File Path Scan)
    in-out property <string> new-scan-path: "";

    // Inputs for Tab 5 (Web Bangs)
    in-out property <string> new-bang-key: "";
    in-out property <string> new-bang-url: "";

    callback select-theme(string);
    callback toggle-show-apps(bool);
    callback move-category-up(int);
    callback move-category-down(int);
    callback filter-apps-changed(string);
    callback toggle-app-item(string, bool);
    callback set-all-apps-visible(bool);
    callback save-cmd-path(string);
    callback add-custom-command(string, string);
    callback remove-custom-command(int);
    callback save-settings-path(string);
    callback add-custom-setting(string, string);
    callback remove-custom-setting(int);
    callback add-file-scan-path(string);
    callback remove-file-scan-path(int);
    callback add-bang(string, string);
    callback remove-bang(string);
    callback reload-index();

    pure function resolve-theme(id: string) -> ThemePalette {
        if (id == "catppuccin-mocha") {
            return {
                window-bg: #1e1e2e,
                surface-bg: #181825,
                card-bg: #313244,
                hover-bg: #2a2b3c,
                selected-bg: #3b3d54,
                border: #45475a,
                accent: #cba6f7,
                text-primary: #cdd6f4,
                text-secondary: #bac2de,
                text-muted: #7f849c,
            };
        }
        if (id == "tokyo-night") {
            return {
                window-bg: #1a1b26,
                surface-bg: #16161e,
                card-bg: #24283b,
                hover-bg: #202436,
                selected-bg: #2f3549,
                border: #3b4261,
                accent: #7aa2f7,
                text-primary: #c0caf5,
                text-secondary: #a9b1d6,
                text-muted: #565f89,
            };
        }
        if (id == "dracula") {
            return {
                window-bg: #282a36,
                surface-bg: #21222c,
                card-bg: #343746,
                hover-bg: #313442,
                selected-bg: #44475a,
                border: #6272a4,
                accent: #bd93f9,
                text-primary: #f8f8f2,
                text-secondary: #e2e2dc,
                text-muted: #6272a4,
            };
        }
        if (id == "nord-frost") {
            return {
                window-bg: #2e3440,
                surface-bg: #242933,
                card-bg: #3b4252,
                hover-bg: #353c4a,
                selected-bg: #434c5e,
                border: #4c566a,
                accent: #88c0d0,
                text-primary: #eceff4,
                text-secondary: #d8dee9,
                text-muted: #7b88a1,
            };
        }
        if (id == "gruvbox-dark") {
            return {
                window-bg: #282828,
                surface-bg: #1d2021,
                card-bg: #3c3836,
                hover-bg: #32302f,
                selected-bg: #504945,
                border: #665c54,
                accent: #fe8019,
                text-primary: #fbf1c7,
                text-secondary: #ebdbb2,
                text-muted: #a89984,
            };
        }
        if (id == "daylight-snow") {
            return {
                window-bg: #f8fafc,
                surface-bg: #ffffff,
                card-bg: #f1f5f9,
                hover-bg: #e2e8f0,
                selected-bg: #e0e7ff,
                border: #cbd5e1,
                accent: #4f46e5,
                text-primary: #0f172a,
                text-secondary: #334155,
                text-muted: #64748b,
            };
        }
        return {
            window-bg: #11131a,
            surface-bg: #181b26,
            card-bg: #202434,
            hover-bg: #1a1e2e,
            selected-bg: #262c44,
            border: #2a2f42,
            accent: #6366f1,
            text-primary: #f3f4f8,
            text-secondary: #c7d2fe,
            text-muted: #6b728e,
        };
    }

    property <ThemePalette> theme: resolve-theme(root.theme-id);

    HorizontalLayout {
        width: 100%;
        height: 100%;

        // Left Navigation Sidebar
        Rectangle {
            width: 220px;
            background: root.theme.surface-bg;
            border-width: 1px;
            border-color: root.theme.border;

            VerticalLayout {
                padding: 16px;
                spacing: 6px;

                HorizontalLayout {
                    spacing: 10px;
                    padding-bottom: 12px;

                    Image {
                        source: root.app-icon;
                        width: 28px;
                        height: 28px;
                    }

                    VerticalLayout {
                        alignment: center;
                        Text {
                            text: "Command Palette";
                            color: root.theme.text-primary;
                            font-size: 14px;
                            font-weight: 700;
                        }
                        Text {
                            text: "Ctrl + Space";
                            color: root.theme.accent;
                            font-size: 11px;
                        }
                    }
                }

                for tab-label[idx] in [
                    "1. Themes & Order",
                    "2. Installed Apps",
                    "3. Custom Commands",
                    "4. Custom Settings",
                    "5. Custom File Scan",
                    "6. Web Search Bangs"
                ] : Rectangle {
                    height: 36px;
                    border-radius: 8px;
                    background: root.active-tab == idx ? root.theme.accent : (nav-touch.has-hover ? root.theme.hover-bg : transparent);

                    nav-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.active-tab = idx;
                            root.status-message = "";
                        }
                    }

                    HorizontalLayout {
                        padding-left: 12px;
                        Text {
                            text: tab-label;
                            color: root.active-tab == idx ? #ffffff : root.theme.text-secondary;
                            font-size: 12px;
                            font-weight: root.active-tab == idx ? 700 : 500;
                            vertical-alignment: center;
                        }
                    }
                }

                Rectangle { vertical-stretch: 1; }

                if root.status-message != "" : Rectangle {
                    height: 32px;
                    border-radius: 6px;
                    background: root.theme.card-bg;
                    border-width: 1px;
                    border-color: root.theme.accent;

                    Text {
                        text: root.status-message;
                        color: root.theme.text-primary;
                        font-size: 11px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                Rectangle {
                    height: 34px;
                    border-radius: 7px;
                    background: reindex-touch.has-hover ? root.theme.selected-bg : root.theme.card-bg;
                    border-width: 1px;
                    border-color: root.theme.border;

                    reindex-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.reload-index();
                        }
                    }

                    Text {
                        text: "↻  Rescan All Indexes";
                        color: root.theme.text-primary;
                        font-size: 12px;
                        font-weight: 600;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // Right Content Panel
        VerticalLayout {
            horizontal-stretch: 1;
            padding: 20px;
            spacing: 12px;

            // ========================================================
            // TAB 0: PREDEFINED THEMES & CATEGORY PREFERENCE ORDER
            // ========================================================
            if root.active-tab == 0 : VerticalLayout {
                spacing: 10px;

                Text {
                    text: "Predefined Themes";
                    color: root.theme.text-primary;
                    font-size: 16px;
                    font-weight: 700;
                }

                ScrollView {
                    height: 175px;
                    VerticalLayout {
                        spacing: 6px;
                        for th in root.themes : Rectangle {
                            height: 42px;
                            border-radius: 8px;
                            background: root.theme-id == th.id ? root.theme.selected-bg : root.theme.card-bg;
                            border-width: root.theme-id == th.id ? 2px : 1px;
                            border-color: root.theme-id == th.id ? root.theme.accent : root.theme.border;

                            th-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.theme-id = th.id;
                                    root.select-theme(th.id);
                                }
                            }

                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                spacing: 12px;

                                // Theme Color Swatches
                                HorizontalLayout {
                                    spacing: 4px;
                                    alignment: center;
                                    VerticalLayout {
                                        alignment: center;
                                        Rectangle {
                                            width: 20px;
                                            height: 20px;
                                            border-radius: 10px;
                                            background: th.bg-preview;
                                            border-width: 1px;
                                            border-color: #888888;
                                        }
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        Rectangle {
                                            width: 20px;
                                            height: 20px;
                                            border-radius: 10px;
                                            background: th.accent-preview;
                                        }
                                    }
                                }

                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    alignment: center;
                                    Text {
                                        text: th.name;
                                        color: root.theme.text-primary;
                                        font-size: 13px;
                                        font-weight: 700;
                                    }
                                    Text {
                                        text: th.subtitle;
                                        color: root.theme.text-muted;
                                        font-size: 11px;
                                    }
                                }

                                VerticalLayout {
                                    alignment: center;
                                    Text {
                                        text: root.theme-id == th.id ? "✓ Active" : "Use Theme";
                                        color: root.theme-id == th.id ? root.theme.accent : root.theme.text-muted;
                                        font-size: 12px;
                                        font-weight: 700;
                                    }
                                }
                            }
                        }
                    }
                }

                Text {
                    text: "Suggestion Category Order of Preference (Top = Highest Priority)";
                    color: root.theme.accent;
                    font-size: 12px;
                    font-weight: 700;
                }

                ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        spacing: 6px;
                        for cat[idx] in root.category-order : Rectangle {
                            height: 44px;
                            border-radius: 8px;
                            background: root.theme.card-bg;
                            border-width: 1px;
                            border-color: root.theme.border;

                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                spacing: 10px;

                                VerticalLayout {
                                    alignment: center;
                                    Rectangle {
                                        width: 24px;
                                        height: 24px;
                                        border-radius: 6px;
                                        background: root.theme.surface-bg;
                                        Text {
                                            text: (idx + 1) + "";
                                            color: root.theme.accent;
                                            font-size: 12px;
                                            font-weight: 700;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                }

                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    alignment: center;
                                    Text {
                                        text: cat.label;
                                        color: root.theme.text-primary;
                                        font-size: 13px;
                                        font-weight: 600;
                                    }
                                    Text {
                                        text: cat.description;
                                        color: root.theme.text-muted;
                                        font-size: 11px;
                                        overflow: elide;
                                    }
                                }

                                VerticalLayout {
                                    alignment: center;
                                    Rectangle {
                                        width: 30px;
                                        height: 26px;
                                        border-radius: 6px;
                                        background: up-touch.has-hover ? root.theme.selected-bg : root.theme.surface-bg;
                                        up-touch := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { root.move-category-up(idx); }
                                        }
                                        Text {
                                            text: "↑";
                                            color: root.theme.text-primary;
                                            font-size: 13px;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                }

                                VerticalLayout {
                                    alignment: center;
                                    Rectangle {
                                        width: 30px;
                                        height: 26px;
                                        border-radius: 6px;
                                        background: down-touch.has-hover ? root.theme.selected-bg : root.theme.surface-bg;
                                        down-touch := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { root.move-category-down(idx); }
                                        }
                                        Text {
                                            text: "↓";
                                            color: root.theme.text-primary;
                                            font-size: 13px;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // ========================================================
            // TAB 1: INSTALLED APPS WITH CHECKBOXES TO SHOW / HIDE
            // ========================================================
            if root.active-tab == 1 : VerticalLayout {
                spacing: 10px;

                HorizontalLayout {
                    alignment: space-between;
                    Text {
                        text: "Installed Applications — Check to Show, Uncheck to Hide";
                        color: root.theme.text-primary;
                        font-size: 16px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }

                    // Master Show/Hide All Buttons
                    HorizontalLayout {
                        spacing: 6px;
                        Rectangle {
                            width: 82px;
                            height: 28px;
                            border-radius: 6px;
                            background: show-all-touch.has-hover ? root.theme.selected-bg : root.theme.card-bg;
                            border-width: 1px;
                            border-color: root.theme.border;
                            show-all-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.set-all-apps-visible(true); }
                            }
                            Text {
                                text: "☑ Show All";
                                color: root.theme.text-primary;
                                font-size: 11px;
                                font-weight: 600;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                        Rectangle {
                            width: 82px;
                            height: 28px;
                            border-radius: 6px;
                            background: hide-all-touch.has-hover ? root.theme.selected-bg : root.theme.card-bg;
                            border-width: 1px;
                            border-color: root.theme.border;
                            hide-all-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.set-all-apps-visible(false); }
                            }
                            Text {
                                text: "☐ Hide All";
                                color: root.theme.text-primary;
                                font-size: 11px;
                                font-weight: 600;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                // Search Filter Bar for Apps List
                Rectangle {
                    height: 34px;
                    border-radius: 7px;
                    background: root.theme.card-bg;
                    border-width: 1px;
                    border-color: root.theme.border;

                    if root.app-filter-text == "" : Text {
                        x: 12px;
                        text: "Filter installed applications by name...";
                        color: root.theme.text-muted;
                        font-size: 12px;
                        vertical-alignment: center;
                        height: 100%;
                    }

                    TextInput {
                        x: 12px;
                        width: parent.width - 24px;
                        height: 100%;
                        text <=> root.app-filter-text;
                        color: root.theme.text-primary;
                        font-size: 12px;
                        vertical-alignment: center;
                        single-line: true;
                        edited => {
                            root.filter-apps-changed(self.text);
                        }
                    }
                }

                ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        spacing: 5px;
                        for app[idx] in root.app-items : Rectangle {
                            height: 38px;
                            border-radius: 7px;
                            background: app-row-touch.has-hover ? root.theme.hover-bg : root.theme.card-bg;
                            border-width: 1px;
                            border-color: app.visible ? root.theme.border : transparent;

                            app-row-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.toggle-app-item(app.name, !app.visible);
                                }
                            }

                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                spacing: 12px;

                                // Checkbox Box
                                VerticalLayout {
                                    alignment: center;
                                    Rectangle {
                                        width: 20px;
                                        height: 20px;
                                        border-radius: 5px;
                                        background: app.visible ? root.theme.accent : root.theme.surface-bg;
                                        border-width: 1px;
                                        border-color: app.visible ? root.theme.accent : root.theme.border;

                                        Text {
                                            text: app.visible ? "✓" : "";
                                            color: #ffffff;
                                            font-size: 13px;
                                            font-weight: 800;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                }

                                Text {
                                    horizontal-stretch: 1;
                                    text: app.name;
                                    color: app.visible ? root.theme.text-primary : root.theme.text-muted;
                                    font-size: 13px;
                                    font-weight: app.visible ? 600 : 400;
                                    overflow: elide;
                                    vertical-alignment: center;
                                }

                                Text {
                                    text: app.visible ? "Shown in Palette" : "Hidden";
                                    color: app.visible ? root.theme.accent : root.theme.text-muted;
                                    font-size: 11px;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }
            }

            // ========================================================
            // TAB 2: CUSTOM COMMANDS (SEPARATED & SIMPLIFIED)
            // ========================================================
            if root.active-tab == 2 : VerticalLayout {
                spacing: 12px;

                Text {
                    text: "Custom Commands (Simplified)";
                    color: root.theme.text-primary;
                    font-size: 16px;
                    font-weight: 700;
                }

                // Default CMD Path bar
                Rectangle {
                    height: 46px;
                    border-radius: 8px;
                    background: root.theme.card-bg;
                    border-width: 1px;
                    border-color: root.theme.border;

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 8px;

                        Text {
                            width: 135px;
                            text: "Default CMD Path:";
                            color: root.theme.text-secondary;
                            font-size: 12px;
                            vertical-alignment: center;
                        }

                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            Rectangle {
                                height: 28px;
                                border-radius: 6px;
                                background: root.theme.surface-bg;
                                border-width: 1px;
                                border-color: root.theme.border;

                                TextInput {
                                    x: 8px;
                                    width: parent.width - 16px;
                                    height: 100%;
                                    text <=> root.custom-cmd-path;
                                    color: root.theme.text-primary;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                    single-line: true;
                                }
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 80px;
                                height: 28px;
                                border-radius: 6px;
                                background: root.theme.accent;
                                TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.save-cmd-path(root.custom-cmd-path); }
                                }
                                Text {
                                    text: "Save";
                                    color: #ffffff;
                                    font-size: 12px;
                                    font-weight: 600;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }

                // Simple 2-Field Add Custom Command Card
                Rectangle {
                    height: 96px;
                    border-radius: 8px;
                    background: root.theme.card-bg;
                    border-width: 1px;
                    border-color: root.theme.border;

                    VerticalLayout {
                        padding: 12px;
                        spacing: 8px;

                        HorizontalLayout {
                            spacing: 8px;
                            Rectangle {
                                width: 200px;
                                height: 32px;
                                border-radius: 6px;
                                background: root.theme.surface-bg;
                                border-width: 1px;
                                border-color: root.theme.border;
                                if root.new-cmd-name == "" : Text {
                                    x: 8px;
                                    text: "Name (e.g. Flush DNS)";
                                    color: root.theme.text-muted;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                    height: 100%;
                                }
                                TextInput {
                                    x: 8px;
                                    width: parent.width - 16px;
                                    height: 100%;
                                    text <=> root.new-cmd-name;
                                    color: root.theme.text-primary;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                    single-line: true;
                                }
                            }

                            Rectangle {
                                horizontal-stretch: 1;
                                height: 32px;
                                border-radius: 6px;
                                background: root.theme.surface-bg;
                                border-width: 1px;
                                border-color: root.theme.border;
                                if root.new-cmd-target == "" : Text {
                                    x: 8px;
                                    text: "Command or EXE Path (e.g. ipconfig /flushdns)";
                                    color: root.theme.text-muted;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                    height: 100%;
                                }
                                TextInput {
                                    x: 8px;
                                    width: parent.width - 16px;
                                    height: 100%;
                                    text <=> root.new-cmd-target;
                                    color: root.theme.text-primary;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                    single-line: true;
                                }
                            }

                            Rectangle {
                                width: 120px;
                                height: 32px;
                                border-radius: 6px;
                                background: root.theme.accent;
                                TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        if (root.new-cmd-name != "" && root.new-cmd-target != "") {
                                            root.add-custom-command(root.new-cmd-name, root.new-cmd-target);
                                            root.new-cmd-name = "";
                                            root.new-cmd-target = "";
                                        }
                                    }
                                }
                                Text {
                                    text: "+ Add Command";
                                    color: #ffffff;
                                    font-size: 12px;
                                    font-weight: 600;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        Text {
                            text: "Tip: Just give your command a name and enter any terminal command or .exe/.bat path.";
                            color: root.theme.text-muted;
                            font-size: 11px;
                        }
                    }
                }

                Text {
                    text: "Saved Custom Commands (" + root.custom-commands.length + ")";
                    color: root.theme.accent;
                    font-size: 12px;
                    font-weight: 700;
                }

                ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        spacing: 6px;
                        for item[idx] in root.custom-commands : Rectangle {
                            height: 44px;
                            border-radius: 8px;
                            background: root.theme.card-bg;
                            border-width: 1px;
                            border-color: root.theme.border;

                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                spacing: 10px;

                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    alignment: center;
                                    Text {
                                        text: "⚡ " + item.name;
                                        color: root.theme.text-primary;
                                        font-size: 13px;
                                        font-weight: 600;
                                    }
                                    Text {
                                        text: item.target;
                                        color: root.theme.text-muted;
                                        font-size: 11px;
                                        overflow: elide;
                                    }
                                }

                                VerticalLayout {
                                    alignment: center;
                                    Rectangle {
                                        width: 72px;
                                        height: 26px;
                                        border-radius: 6px;
                                        background: root.theme.surface-bg;
                                        TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { root.remove-custom-command(idx); }
                                        }
                                        Text {
                                            text: "Remove";
                                            color: #fda4af;
                                            font-size: 11px;
                                            font-weight: 600;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // ========================================================
            // TAB 3: CUSTOM SYSTEM SETTINGS (SEPARATED & SIMPLIFIED)
            // ========================================================
            if root.active-tab == 3 : VerticalLayout {
                spacing: 12px;

                Text {
                    text: "Custom System Settings (Simplified)";
                    color: root.theme.text-primary;
                    font-size: 16px;
                    font-weight: 700;
                }

                // Default System Settings URI / Path bar
                Rectangle {
                    height: 46px;
                    border-radius: 8px;
                    background: root.theme.card-bg;
                    border-width: 1px;
                    border-color: root.theme.border;

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 8px;

                        Text {
                            width: 155px;
                            text: "Default Settings URI/Path:";
                            color: root.theme.text-secondary;
                            font-size: 12px;
                            vertical-alignment: center;
                        }

                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            Rectangle {
                                height: 28px;
                                border-radius: 6px;
                                background: root.theme.surface-bg;
                                border-width: 1px;
                                border-color: root.theme.border;

                                TextInput {
                                    x: 8px;
                                    width: parent.width - 16px;
                                    height: 100%;
                                    text <=> root.custom-settings-path;
                                    color: root.theme.text-primary;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                    single-line: true;
                                }
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 80px;
                                height: 28px;
                                border-radius: 6px;
                                background: root.theme.accent;
                                TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.save-settings-path(root.custom-settings-path); }
                                }
                                Text {
                                    text: "Save";
                                    color: #ffffff;
                                    font-size: 12px;
                                    font-weight: 600;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }

                // Simple 2-Field Add Custom Setting Card
                Rectangle {
                    height: 96px;
                    border-radius: 8px;
                    background: root.theme.card-bg;
                    border-width: 1px;
                    border-color: root.theme.border;

                    VerticalLayout {
                        padding: 12px;
                        spacing: 8px;

                        HorizontalLayout {
                            spacing: 8px;
                            Rectangle {
                                width: 200px;
                                height: 32px;
                                border-radius: 6px;
                                background: root.theme.surface-bg;
                                border-width: 1px;
                                border-color: root.theme.border;
                                if root.new-setting-name == "" : Text {
                                    x: 8px;
                                    text: "Name (e.g. Device Manager)";
                                    color: root.theme.text-muted;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                    height: 100%;
                                }
                                TextInput {
                                    x: 8px;
                                    width: parent.width - 16px;
                                    height: 100%;
                                    text <=> root.new-setting-name;
                                    color: root.theme.text-primary;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                    single-line: true;
                                }
                            }

                            Rectangle {
                                horizontal-stretch: 1;
                                height: 32px;
                                border-radius: 6px;
                                background: root.theme.surface-bg;
                                border-width: 1px;
                                border-color: root.theme.border;
                                if root.new-setting-path == "" : Text {
                                    x: 8px;
                                    text: "Path or URI (e.g. devmgmt.msc or ms-settings:privacy)";
                                    color: root.theme.text-muted;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                    height: 100%;
                                }
                                TextInput {
                                    x: 8px;
                                    width: parent.width - 16px;
                                    height: 100%;
                                    text <=> root.new-setting-path;
                                    color: root.theme.text-primary;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                    single-line: true;
                                }
                            }

                            Rectangle {
                                width: 120px;
                                height: 32px;
                                border-radius: 6px;
                                background: root.theme.accent;
                                TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        if (root.new-setting-name != "" && root.new-setting-path != "") {
                                            root.add-custom-setting(root.new-setting-name, root.new-setting-path);
                                            root.new-setting-name = "";
                                            root.new-setting-path = "";
                                        }
                                    }
                                }
                                Text {
                                    text: "+ Add Setting";
                                    color: #ffffff;
                                    font-size: 12px;
                                    font-weight: 600;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        Text {
                            text: "Examples: devmgmt.msc (Device Manager), sysdm.cpl (System Properties), appwiz.cpl, ms-settings:startupapps";
                            color: root.theme.text-muted;
                            font-size: 11px;
                        }
                    }
                }

                Text {
                    text: "Saved Custom Settings (" + root.custom-settings.length + ")";
                    color: root.theme.accent;
                    font-size: 12px;
                    font-weight: 700;
                }

                ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        spacing: 6px;
                        for item[idx] in root.custom-settings : Rectangle {
                            height: 44px;
                            border-radius: 8px;
                            background: root.theme.card-bg;
                            border-width: 1px;
                            border-color: root.theme.border;

                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                spacing: 10px;

                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    alignment: center;
                                    Text {
                                        text: "⚙ " + item.name;
                                        color: root.theme.text-primary;
                                        font-size: 13px;
                                        font-weight: 600;
                                    }
                                    Text {
                                        text: item.target;
                                        color: root.theme.text-muted;
                                        font-size: 11px;
                                        overflow: elide;
                                    }
                                }

                                VerticalLayout {
                                    alignment: center;
                                    Rectangle {
                                        width: 72px;
                                        height: 26px;
                                        border-radius: 6px;
                                        background: root.theme.surface-bg;
                                        TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { root.remove-custom-setting(idx); }
                                        }
                                        Text {
                                            text: "Remove";
                                            color: #fda4af;
                                            font-size: 11px;
                                            font-weight: 600;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // ========================================================
            // TAB 4: CUSTOM FILE PATH SCAN (ONLY SCANS ADDED PATHS)
            // ========================================================
            if root.active-tab == 4 : VerticalLayout {
                spacing: 12px;

                Text {
                    text: "Custom File Scan Paths (Open Files Directly)";
                    color: root.theme.text-primary;
                    font-size: 16px;
                    font-weight: 700;
                }

                Rectangle {
                    height: 88px;
                    border-radius: 8px;
                    background: root.theme.card-bg;
                    border-width: 1px;
                    border-color: root.theme.border;

                    VerticalLayout {
                        padding: 12px;
                        spacing: 8px;

                        HorizontalLayout {
                            spacing: 8px;
                            Rectangle {
                                horizontal-stretch: 1;
                                height: 32px;
                                border-radius: 6px;
                                background: root.theme.surface-bg;
                                border-width: 1px;
                                border-color: root.theme.border;
                                if root.new-scan-path == "" : Text {
                                    x: 10px;
                                    text: "Enter folder path to scan its files (e.g. C:\\Users\\You\\Documents or D:\\Notes)";
                                    color: root.theme.text-muted;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                    height: 100%;
                                }
                                TextInput {
                                    x: 10px;
                                    width: parent.width - 20px;
                                    height: 100%;
                                    text <=> root.new-scan-path;
                                    color: root.theme.text-primary;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                    single-line: true;
                                }
                            }

                            Rectangle {
                                width: 130px;
                                height: 32px;
                                border-radius: 6px;
                                background: root.theme.accent;
                                TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        if (root.new-scan-path != "") {
                                            root.add-file-scan-path(root.new-scan-path);
                                            root.new-scan-path = "";
                                        }
                                    }
                                }
                                Text {
                                    text: "+ Add Scan Path";
                                    color: #ffffff;
                                    font-size: 12px;
                                    font-weight: 600;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        Text {
                            text: "No full-system scan is performed. Only the paths added here are scanned (" + root.indexed-files-count + " files currently indexed).";
                            color: root.theme.text-muted;
                            font-size: 11px;
                        }
                    }
                }

                Text {
                    text: "Active Custom Scan Paths (" + root.custom-file-scan-paths.length + ")";
                    color: root.theme.accent;
                    font-size: 12px;
                    font-weight: 700;
                }

                ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        spacing: 6px;
                        for scan-dir[idx] in root.custom-file-scan-paths : Rectangle {
                            height: 40px;
                            border-radius: 8px;
                            background: root.theme.card-bg;
                            border-width: 1px;
                            border-color: root.theme.border;

                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                alignment: space-between;

                                Text {
                                    text: "📁  " + scan-dir;
                                    color: root.theme.text-primary;
                                    font-size: 13px;
                                    overflow: elide;
                                    vertical-alignment: center;
                                }

                                VerticalLayout {
                                    alignment: center;
                                    Rectangle {
                                        width: 72px;
                                        height: 26px;
                                        border-radius: 6px;
                                        background: root.theme.surface-bg;
                                        TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { root.remove-file-scan-path(idx); }
                                        }
                                        Text {
                                            text: "Remove";
                                            color: #fda4af;
                                            font-size: 11px;
                                            font-weight: 600;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // ========================================================
            // TAB 5: WEB BANG SHORTCUTS
            // ========================================================
            if root.active-tab == 5 : VerticalLayout {
                spacing: 12px;

                Text {
                    text: "Prefix-Free Web Search Bangs";
                    color: root.theme.text-primary;
                    font-size: 16px;
                    font-weight: 700;
                }

                HorizontalLayout {
                    spacing: 8px;
                    Rectangle {
                        width: 110px;
                        height: 32px;
                        border-radius: 6px;
                        background: root.theme.card-bg;
                        border-width: 1px;
                        border-color: root.theme.border;
                        if root.new-bang-key == "" : Text {
                            x: 10px;
                            text: "Key (e.g. yt)";
                            color: root.theme.text-muted;
                            font-size: 12px;
                            vertical-alignment: center;
                            height: 100%;
                        }
                        TextInput {
                            x: 10px;
                            width: parent.width - 20px;
                            height: 100%;
                            text <=> root.new-bang-key;
                            color: root.theme.text-primary;
                            font-size: 12px;
                            vertical-alignment: center;
                            single-line: true;
                        }
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                        height: 32px;
                        border-radius: 6px;
                        background: root.theme.card-bg;
                        border-width: 1px;
                        border-color: root.theme.border;
                        if root.new-bang-url == "" : Text {
                            x: 10px;
                            text: "URL with {q} (e.g. https://www.youtube.com/results?search_query={q})";
                            color: root.theme.text-muted;
                            font-size: 12px;
                            vertical-alignment: center;
                            height: 100%;
                        }
                        TextInput {
                            x: 10px;
                            width: parent.width - 20px;
                            height: 100%;
                            text <=> root.new-bang-url;
                            color: root.theme.text-primary;
                            font-size: 12px;
                            vertical-alignment: center;
                            single-line: true;
                        }
                    }

                    Rectangle {
                        width: 105px;
                        height: 32px;
                        border-radius: 6px;
                        background: root.theme.accent;
                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                if (root.new-bang-key != "" && root.new-bang-url != "") {
                                    root.add-bang(root.new-bang-key, root.new-bang-url);
                                    root.new-bang-key = "";
                                    root.new-bang-url = "";
                                }
                            }
                        }
                        Text {
                            text: "+ Add Bang";
                            color: #ffffff;
                            font-size: 12px;
                            font-weight: 600;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }

                ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        spacing: 5px;
                        for bang[idx] in root.bang-entries : Rectangle {
                            height: 38px;
                            border-radius: 7px;
                            background: root.theme.card-bg;
                            border-width: 1px;
                            border-color: root.theme.border;

                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                spacing: 10px;

                                Text {
                                    width: 65px;
                                    text: "[" + bang.key + "]";
                                    color: root.theme.accent;
                                    font-size: 12px;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                }

                                Text {
                                    horizontal-stretch: 1;
                                    text: bang.url;
                                    color: root.theme.text-secondary;
                                    font-size: 12px;
                                    overflow: elide;
                                    vertical-alignment: center;
                                }

                                VerticalLayout {
                                    alignment: center;
                                    Rectangle {
                                        width: 72px;
                                        height: 24px;
                                        border-radius: 5px;
                                        background: root.theme.surface-bg;
                                        TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { root.remove-bang(bang.key); }
                                        }
                                        Text {
                                            text: "Remove";
                                            color: #fda4af;
                                            font-size: 11px;
                                            font-weight: 600;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
