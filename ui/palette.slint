import { ScrollView } from "std-widgets.slint";

export struct PaletteEntry {
    title: string,
    subtitle: string,
    badge: string,
    category: string,
    section_header: string,
    icon: string,
    can_elevate: bool,
}

export struct CategoryEntry {
    rank: int,
    id: string,
    label: string,
    description: string,
    icon: string,
    is_first: bool,
    is_last: bool,
}

export struct AppToggleEntry {
    name: string,
    path: string,
    visible: bool,
}

export struct BuiltinToggleEntry {
    id: string,
    title: string,
    subtitle: string,
    enabled: bool,
}

export struct CustomCmdEntry {
    name: string,
    command: string,
}

export struct CustomSettingEntry {
    name: string,
    path: string,
}

export struct BangEntry {
    trigger: string,
    url: string,
}

export struct NoteBangEntry {
    bang: string,
    name: string,
    file_path: string,
}

// ============================================================================
// SHARED MINIMAL UI PRIMITIVES (Consistent across Palette & Settings)
// ============================================================================
component FlatInput inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;
    in property <color> surface-bg: #262626;
    in property <color> border-col: #363636;
    in property <color> accent: #60cdff;
    in property <color> text-primary: #f5f5f5;
    in property <color> text-muted: #9a9a9a;
    callback edited(string);
    callback accepted();

    height: 32px;
    border-radius: 6px;
    background: surface-bg;
    border-width: 1px;
    border-color: input-el.has-focus ? accent : border-col;

    Text {
        x: 10px;
        width: parent.width - 20px;
        height: 100%;
        text: root.placeholder;
        color: root.text-muted;
        font-size: 12px;
        vertical-alignment: center;
        visible: root.text == "";
        overflow: elide;
    }

    input-el := TextInput {
        x: 10px;
        width: parent.width - 20px;
        height: 100%;
        text <=> root.text;
        color: root.text-primary;
        font-size: 12px;
        vertical-alignment: center;
        single-line: true;
        edited => { root.edited(self.text); }
        accepted => { root.accepted(); }
    }
}

component ActionBtn inherits Rectangle {
    in property <string> label;
    in property <bool> primary: false;
    in property <bool> danger: false;
    in property <color> accent: #60cdff;
    in property <color> surface-bg: #262626;
    in property <color> selected-bg: #323232;
    in property <color> border-col: #363636;
    in property <color> text-primary: #f5f5f5;
    callback clicked();

    height: 30px;
    min-width: 68px;
    border-radius: 6px;
    border-width: primary ? 0px : 1px;
    border-color: danger ? #5a2a2a : border-col;
    background: primary ? (ta.has-hover ? accent.brighter(0.12) : accent) :
                danger ? (ta.has-hover ? #4d2222 : #331a1a) :
                (ta.has-hover ? selected-bg : surface-bg);

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        alignment: center;
        Text {
            text: root.label;
            font-size: 11.5px;
            font-weight: 600;
            color: root.primary ? #101010 : (root.danger ? #ff9999 : root.text-primary);
            vertical-alignment: center;
        }
    }

    ta := TouchArea {
        clicked => { root.clicked(); }
    }
}

component PillSwitch inherits Rectangle {
    in property <bool> checked: false;
    in property <color> accent: #60cdff;
    in property <color> surface-bg: #262626;
    in property <color> border-col: #363636;
    callback toggled(bool);

    width: 38px;
    height: 20px;
    border-radius: 10px;
    background: checked ? accent : surface-bg;
    border-width: 1px;
    border-color: checked ? accent : border-col;

    Rectangle {
        x: root.checked ? 20px : 2px;
        y: 2px;
        width: 16px;
        height: 16px;
        border-radius: 8px;
        background: root.checked ? #101010 : #b5b5b5;
        animate x { duration: 110ms; easing: ease-out; }
    }

    TouchArea {
        clicked => { root.toggled(!root.checked); }
    }
}

component SettingCard inherits Rectangle {
    in property <color> card-bg: #242424;
    in property <color> border-col: #363636;

    border-radius: 8px;
    background: card-bg;
    border-width: 1px;
    border-color: border-col;
}

component SidebarNavItem inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <bool> active: false;
    in property <color> accent: #60cdff;
    in property <color> selected-bg: #323232;
    in property <color> text-primary: #f5f5f5;
    in property <color> text-muted: #9a9a9a;
    callback clicked();

    height: 34px;
    border-radius: 6px;
    background: active ? selected-bg : (ta.has-hover ? selected-bg.darker(0.2) : transparent);

    Rectangle {
        x: 0px;
        y: 8px;
        width: 3px;
        height: parent.height - 16px;
        border-radius: 1.5px;
        background: root.active ? root.accent : transparent;
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 10px;
        spacing: 9px;
        alignment: start;

        Text {
            text: root.icon;
            font-size: 13px;
            color: root.active ? root.accent : root.text-muted;
            vertical-alignment: center;
            width: 18px;
        }

        Text {
            text: root.label;
            font-size: 12.5px;
            font-weight: root.active ? 600 : 400;
            color: root.active ? root.text-primary : root.text-muted;
            vertical-alignment: center;
        }
    }

    ta := TouchArea {
        clicked => { root.clicked(); }
    }
}

// ============================================================================
// MAIN COMMAND PALETTE WINDOW
// ============================================================================
export component PaletteWindow inherits Window {
    title: "Command Palette";
    no-frame: true;
    always-on-top: true;
    width: 680px;
    height: 440px;
    min-width: 680px;
    max-width: 680px;
    min-height: 440px;
    max-height: 440px;
    background: transparent;

    in property <image> window_icon;
    icon: root.window_icon;

    in property <color> theme_window_bg: #1e1e1e;
    in property <color> theme_surface_bg: #262626;
    in property <color> theme_card_bg: #242424;
    in property <color> theme_selected_bg: #323232;
    in property <color> theme_border: #363636;
    in property <color> theme_accent: #60cdff;
    in property <color> theme_text_primary: #f5f5f5;
    in property <color> theme_text_muted: #9a9a9a;

    in-out property <string> search_text: "";
    in-out property <string> active_bang: "";
    in-out property <string> active_bang_label: "";
    in-out property <[PaletteEntry]> entries: [];
    in-out property <int> selected_index: 0;

    callback query_changed(string);
    callback clear_active_bang();
    callback move_selection(int);
    callback activate_selected(bool);
    callback activate_index(int, bool);
    callback close_palette();
    callback open_settings();

    public function focus_input() {
        search-input.focus();
    }

    Rectangle {
        width: 100%;
        height: 100%;
        background: root.theme_window_bg;
        border-radius: 10px;
        border-width: 1px;
        border-color: root.theme_border;
        clip: true;

        VerticalLayout {
            padding: 12px;
            spacing: 8px;

            // Search Bar
            Rectangle {
                height: 44px;
                background: root.theme_surface_bg;
                border-radius: 7px;
                border-width: 1px;
                border-color: search-input.has-focus ? root.theme_accent : root.theme_border;

                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 10px;
                    spacing: 8px;
                    alignment: center;

                    Text {
                        text: "⌕";
                        font-size: 16px;
                        color: root.theme_accent;
                        vertical-alignment: center;
                        width: 18px;
                    }

                    // Active Bang Chip (Note bang or Web bang)
                    if root.active_bang != "" : Rectangle {
                        height: 24px;
                        width: bang-chip-layout.preferred-width + 14px;
                        border-radius: 5px;
                        background: root.theme_accent.with-alpha(0.16);
                        border-width: 1px;
                        border-color: root.theme_accent;

                        bang-chip-layout := HorizontalLayout {
                            padding-left: 7px;
                            padding-right: 7px;
                            spacing: 5px;
                            alignment: center;

                            Text {
                                text: root.active_bang_label;
                                color: root.theme_accent;
                                font-size: 11px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }

                            Text {
                                text: "✕";
                                color: root.theme_text_muted;
                                font-size: 10px;
                                vertical-alignment: center;
                            }
                        }

                        TouchArea {
                            clicked => { root.clear_active_bang(); }
                        }
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                        height: 100%;

                        Text {
                            width: 100%;
                            height: 100%;
                            text: root.active_bang != "" ?
                                  "Type text & press Enter (or filter lines)..." :
                                  "Search apps, commands, math, or type a bang (note, todo, yt, g)...";
                            color: root.theme_text_muted;
                            font-size: 13.5px;
                            vertical-alignment: center;
                            visible: root.search_text == "";
                            overflow: elide;
                        }

                        search-input := TextInput {
                            width: 100%;
                            height: 100%;
                            text <=> root.search_text;
                            font-size: 14px;
                            color: root.theme_text_primary;
                            vertical-alignment: center;
                            single-line: true;

                            edited => {
                                root.query_changed(self.text);
                            }

                            key-pressed(event) => {
                                if (event.text == Key.Backspace && self.text == "" && root.active_bang != "") {
                                    root.clear_active_bang();
                                    return accept;
                                }
                                if (event.text == Key.DownArrow) {
                                    root.move_selection(1);
                                    return accept;
                                }
                                if (event.text == Key.UpArrow) {
                                    root.move_selection(-1);
                                    return accept;
                                }
                                if (event.text == Key.Return) {
                                    root.activate_selected(event.modifiers.control && event.modifiers.shift);
                                    return accept;
                                }
                                if (event.text == Key.Escape) {
                                    if (root.active_bang != "") {
                                        root.clear_active_bang();
                                    } else {
                                        root.close_palette();
                                    }
                                    return accept;
                                }
                                if (event.modifiers.control && event.text == ",") {
                                    root.open_settings();
                                    return accept;
                                }
                                return reject;
                            }
                        }
                    }

                    Rectangle {
                        width: 28px;
                        height: 28px;
                        border-radius: 5px;
                        background: gear-ta.has-hover ? root.theme_selected_bg : transparent;

                        Text {
                            text: "⚙";
                            font-size: 14px;
                            color: root.theme_text_muted;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        gear-ta := TouchArea {
                            clicked => { root.open_settings(); }
                        }
                    }
                }
            }

            // Results Shelf Area
            Rectangle {
                vertical-stretch: 1;
                background: transparent;
                clip: true;

                if root.entries.length == 0 : VerticalLayout {
                    alignment: center;
                    spacing: 6px;

                    Text {
                        text: root.search_text == "" ? "Ready when you are" : "No matching results";
                        font-size: 13.5px;
                        font-weight: 600;
                        color: root.theme_text_primary;
                        horizontal-alignment: center;
                    }

                    Text {
                        text: "Try 'note ', 'todo ', 'g ', '24*7', 'tm', or press Ctrl+, for Settings";
                        font-size: 11.5px;
                        color: root.theme_text_muted;
                        horizontal-alignment: center;
                    }
                }

                if root.entries.length > 0 : ScrollView {
                    width: 100%;
                    height: 100%;
                    viewport-height: root.entries.length * 52px;

                    VerticalLayout {
                        spacing: 3px;
                        padding-right: 4px;

                        for item[idx] in root.entries : VerticalLayout {
                            spacing: 2px;

                            if item.section_header != "" : Rectangle {
                                height: 20px;
                                Text {
                                    x: 6px;
                                    text: item.section_header;
                                    font-size: 10px;
                                    font-weight: 700;
                                    color: root.theme_accent;
                                    vertical-alignment: center;
                                }
                            }

                            Rectangle {
                                height: 44px;
                                border-radius: 6px;
                                background: idx == root.selected_index ? root.theme_selected_bg :
                                            (row-ta.has-hover ? root.theme_card_bg : transparent);

                                Rectangle {
                                    x: 0px;
                                    y: 9px;
                                    width: 3px;
                                    height: parent.height - 18px;
                                    border-radius: 1.5px;
                                    background: idx == root.selected_index ? root.theme_accent : transparent;
                                }

                                row-ta := TouchArea {
                                    clicked => {
                                        root.selected_index = idx;
                                        root.activate_index(idx, false);
                                    }
                                }

                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    spacing: 10px;
                                    alignment: center;

                                    Rectangle {
                                        width: 28px;
                                        height: 28px;
                                        border-radius: 6px;
                                        background: root.theme_surface_bg;
                                        border-width: 1px;
                                        border-color: root.theme_border;

                                        Text {
                                            text: item.icon;
                                            font-size: 13px;
                                            color: root.theme_accent;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }

                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        alignment: center;
                                        spacing: 1px;

                                        Text {
                                            text: item.title;
                                            font-size: 13px;
                                            font-weight: idx == root.selected_index ? 600 : 500;
                                            color: root.theme_text_primary;
                                            overflow: elide;
                                        }

                                        Text {
                                            text: item.subtitle;
                                            font-size: 11px;
                                            color: root.theme_text_muted;
                                            overflow: elide;
                                        }
                                    }

                                    if item.can_elevate && (idx == root.selected_index || row-ta.has-hover) : Rectangle {
                                        width: 64px;
                                        height: 22px;
                                        border-radius: 4px;
                                        background: admin-ta.has-hover ? root.theme_accent : root.theme_surface_bg;
                                        border-width: 1px;
                                        border-color: root.theme_border;

                                        Text {
                                            text: "Admin";
                                            font-size: 10.5px;
                                            font-weight: 600;
                                            color: admin-ta.has-hover ? #101010 : root.theme_text_primary;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }

                                        admin-ta := TouchArea {
                                            clicked => {
                                                root.selected_index = idx;
                                                root.activate_index(idx, true);
                                            }
                                        }
                                    }

                                    Rectangle {
                                        width: 72px;
                                        height: 20px;
                                        border-radius: 4px;
                                        background: root.theme_surface_bg;

                                        Text {
                                            text: item.badge;
                                            font-size: 10px;
                                            color: root.theme_text_muted;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // Minimal Footer Bar
            Rectangle {
                height: 22px;
                HorizontalLayout {
                    padding-left: 4px;
                    padding-right: 4px;
                    spacing: 14px;

                    Text {
                        text: "↑↓ Navigate";
                        font-size: 10.5px;
                        color: root.theme_text_muted;
                        vertical-alignment: center;
                    }
                    Text {
                        text: "↵ Open";
                        font-size: 10.5px;
                        color: root.theme_text_muted;
                        vertical-alignment: center;
                    }
                    Text {
                        text: "Ctrl+Shift+↵ Admin";
                        font-size: 10.5px;
                        color: root.theme_text_muted;
                        vertical-alignment: center;
                    }
                    Rectangle { horizontal-stretch: 1; }
                    Text {
                        text: "Ctrl+, Settings  •  Esc Hide";
                        font-size: 10.5px;
                        color: root.theme_text_muted;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}

// ============================================================================
// MINIMAL, UNIFIED SETTINGS WINDOW (Sidebar Navigation + Shared Design System)
// ============================================================================
export component SettingsWindow inherits Window {
    title: "Command Palette Settings";
    width: 780px;
    height: 560px;
    min-width: 720px;
    min-height: 500px;
    background: root.theme_window_bg;

    in property <image> window_icon;
    icon: root.window_icon;

    in property <color> theme_window_bg: #1e1e1e;
    in property <color> theme_surface_bg: #262626;
    in property <color> theme_card_bg: #242424;
    in property <color> theme_selected_bg: #323232;
    in property <color> theme_border: #363636;
    in property <color> theme_accent: #60cdff;
    in property <color> theme_text_primary: #f5f5f5;
    in property <color> theme_text_muted: #9a9a9a;

    in-out property <int> active_tab: 0;

    // General & Toggles
    in-out property <bool> show_apps: true;
    in-out property <bool> run_on_startup: false;
    in-out property <string> hotkey_str: "Ctrl+Space";
    in-out property <string> theme_mode: "powertoys";

    in-out property <bool> enable_cmdpal_shortcuts: true;
    in-out property <bool> enable_builtin_cmds: true;
    in-out property <bool> enable_builtin_settings: true;

    // Search Engine
    in-out property <string> default_search_engine: "google";
    in-out property <string> custom_search_url: "https://www.google.com/search?q={q}";

    // Custom Theme Hex
    in-out property <string> custom_window_bg: "#1f1f1f";
    in-out property <string> custom_surface_bg: "#2b2b2b";
    in-out property <string> custom_card_bg: "#282828";
    in-out property <string> custom_selected_bg: "#383838";
    in-out property <string> custom_border: "#3d3d3d";
    in-out property <string> custom_accent: "#60cdff";
    in-out property <string> custom_text_primary: "#ffffff";
    in-out property <string> custom_text_muted: "#9d9d9d";

    // Paths
    in-out property <string> custom_cmd_path: "cmd.exe";
    in-out property <string> custom_settings_path: "ms-settings:";

    // List Models
    in-out property <[CategoryEntry]> category_entries: [];
    in-out property <[BuiltinToggleEntry]> builtin_cmd_entries: [];
    in-out property <[BuiltinToggleEntry]> builtin_setting_entries: [];
    in-out property <[AppToggleEntry]> app_entries: [];
    in-out property <[string]> folder_entries: [];
    in-out property <[CustomCmdEntry]> custom_cmd_entries: [];
    in-out property <[CustomSettingEntry]> custom_setting_entries: [];
    in-out property <[BangEntry]> bang_entries: [];
    in-out property <[NoteBangEntry]> note_entries: [];

    // Form Drafts
    in-out property <string> note_bang_input: "";
    in-out property <string> note_name_input: "";
    in-out property <string> note_file_input: "";

    in-out property <string> new_bang_trigger: "";
    in-out property <string> new_bang_url: "";

    in-out property <string> builtin_filter_text: "";
    in-out property <string> new_cmd_name: "";
    in-out property <string> new_cmd_val: "";
    in-out property <string> new_set_name: "";
    in-out property <string> new_set_val: "";

    in-out property <string> app_filter_text: "";
    in-out property <string> new_folder_input: "";

    callback save_general_settings(
        bool, bool, string, string,
        bool, bool, bool,
        string, string,
        string, string, string, string, string, string, string, string,
        string, string
    );
    callback move_category_up(int);
    callback move_category_down(int);
    callback builtin_filter_changed(string);
    callback toggle_builtin_cmd(string, bool);
    callback toggle_builtin_setting(string, bool);
    callback toggle_app_visibility(string, bool);
    callback app_filter_changed(string);
    callback add_scan_folder(string);
    callback remove_scan_folder(int);
    callback add_custom_cmd(string, string);
    callback remove_custom_cmd(int);
    callback add_custom_setting(string, string);
    callback remove_custom_setting(int);
    callback add_bang(string, string);
    callback remove_bang(string);
    callback upsert_note_bang(string, string, string);
    callback remove_note_bang(string);
    callback open_note_file(string);
    callback rescan_indexes();
    callback close_window();

    function commit_all() {
        root.save_general_settings(
            root.show_apps, root.run_on_startup, root.hotkey_str, root.theme_mode,
            root.enable_cmdpal_shortcuts, root.enable_builtin_cmds, root.enable_builtin_settings,
            root.default_search_engine, root.custom_search_url,
            root.custom_window_bg, root.custom_surface_bg, root.custom_card_bg,
            root.custom_selected_bg, root.custom_border, root.custom_accent,
            root.custom_text_primary, root.custom_text_muted,
            root.custom_cmd_path, root.custom_settings_path
        );
    }

    HorizontalLayout {
        width: 100%;
        height: 100%;

        // ====================================================================
        // LEFT NAVIGATION SIDEBAR
        // ====================================================================
        Rectangle {
            width: 195px;
            background: root.theme_card_bg;
            border-width: 1px;
            border-color: root.theme_border;

            VerticalLayout {
                padding: 14px;
                spacing: 4px;

                // App Header
                HorizontalLayout {
                    spacing: 9px;
                    padding-bottom: 12px;
                    alignment: start;

                    Rectangle {
                        width: 26px;
                        height: 26px;
                        border-radius: 6px;
                        background: root.theme_surface_bg;
                        border-width: 1px;
                        border-color: root.theme_border;
                        Text {
                            text: "⌘";
                            font-size: 13px;
                            color: root.theme_accent;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        Text {
                            text: "CmdPal";
                            font-size: 13.5px;
                            font-weight: 700;
                            color: root.theme_text_primary;
                        }
                        Text {
                            text: "Settings";
                            font-size: 10.5px;
                            color: root.theme_text_muted;
                        }
                    }
                }

                SidebarNavItem {
                    icon: "⚙"; label: "General & Order";
                    active: root.active_tab == 0;
                    accent: root.theme_accent; selected-bg: root.theme_selected_bg;
                    text-primary: root.theme_text_primary; text-muted: root.theme_text_muted;
                    clicked => { root.active_tab = 0; }
                }
                SidebarNavItem {
                    icon: "📝"; label: "Note Bangs";
                    active: root.active_tab == 1;
                    accent: root.theme_accent; selected-bg: root.theme_selected_bg;
                    text-primary: root.theme_text_primary; text-muted: root.theme_text_muted;
                    clicked => { root.active_tab = 1; }
                }
                SidebarNavItem {
                    icon: "🌐"; label: "Web & Bangs";
                    active: root.active_tab == 2;
                    accent: root.theme_accent; selected-bg: root.theme_selected_bg;
                    text-primary: root.theme_text_primary; text-muted: root.theme_text_muted;
                    clicked => { root.active_tab = 2; }
                }
                SidebarNavItem {
                    icon: "⚡"; label: "Commands";
                    active: root.active_tab == 3;
                    accent: root.theme_accent; selected-bg: root.theme_selected_bg;
                    text-primary: root.theme_text_primary; text-muted: root.theme_text_muted;
                    clicked => { root.active_tab = 3; }
                }
                SidebarNavItem {
                    icon: "❖"; label: "Apps & Files";
                    active: root.active_tab == 4;
                    accent: root.theme_accent; selected-bg: root.theme_selected_bg;
                    text-primary: root.theme_text_primary; text-muted: root.theme_text_muted;
                    clicked => { root.active_tab = 4; }
                }
                SidebarNavItem {
                    icon: "🎨"; label: "Appearance";
                    active: root.active_tab == 5;
                    accent: root.theme_accent; selected-bg: root.theme_selected_bg;
                    text-primary: root.theme_text_primary; text-muted: root.theme_text_muted;
                    clicked => { root.active_tab = 5; }
                }

                Rectangle { vertical-stretch: 1; }

                ActionBtn {
                    label: "↻ Rescan Index";
                    accent: root.theme_accent; surface-bg: root.theme_surface_bg;
                    selected-bg: root.theme_selected_bg; border-col: root.theme_border;
                    text-primary: root.theme_text_primary;
                    clicked => { root.rescan_indexes(); }
                }
            }
        }

        // ====================================================================
        // RIGHT CONTENT AREA
        // ====================================================================
        VerticalLayout {
            horizontal-stretch: 1;
            padding: 18px;
            spacing: 12px;

            // Main Scrollable Tab Body
            Rectangle {
                vertical-stretch: 1;
                clip: true;

                // ------------------------------------------------------------
                // TAB 0: GENERAL & SHELF ORDER
                // ------------------------------------------------------------
                if root.active_tab == 0 : ScrollView {
                    width: 100%;
                    height: 100%;

                    VerticalLayout {
                        spacing: 12px;
                        padding-right: 6px;

                        Text {
                            text: "General & Shelf Order";
                            font-size: 16px;
                            font-weight: 700;
                            color: root.theme_text_primary;
                        }

                        // Startup & Global Hotkey Card
                        SettingCard {
                            card-bg: root.theme_card_bg; border-col: root.theme_border;
                            VerticalLayout {
                                padding: 12px;
                                spacing: 10px;

                                HorizontalLayout {
                                    alignment: space-between;
                                    VerticalLayout {
                                        spacing: 2px;
                                        Text { text: "Run on Windows Startup"; font-size: 12.5px; font-weight: 600; color: root.theme_text_primary; }
                                        Text { text: "Start silently in the system tray when signing in"; font-size: 11px; color: root.theme_text_muted; }
                                    }
                                    PillSwitch {
                                        checked: root.run_on_startup;
                                        accent: root.theme_accent; surface-bg: root.theme_surface_bg; border-col: root.theme_border;
                                        toggled(v) => { root.run_on_startup = v; root.commit_all(); }
                                    }
                                }

                                Rectangle { height: 1px; background: root.theme_border; }

                                HorizontalLayout {
                                    spacing: 8px;
                                    alignment: center;
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 2px;
                                        Text { text: "Global Activation Hotkey"; font-size: 12.5px; font-weight: 600; color: root.theme_text_primary; }
                                        Text { text: "Press from anywhere in Windows to toggle palette"; font-size: 11px; color: root.theme_text_muted; }
                                    }
                                    FlatInput {
                                        width: 135px;
                                        text <=> root.hotkey_str;
                                        placeholder: "Ctrl+Space";
                                        surface-bg: root.theme_surface_bg; border-col: root.theme_border;
                                        accent: root.theme_accent; text-primary: root.theme_text_primary; text-muted: root.theme_text_muted;
                                    }
                                    ActionBtn {
                                        label: "Ctrl+Space";
                                        accent: root.theme_accent; surface-bg: root.theme_surface_bg;
                                        selected-bg: root.theme_selected_bg; border-col: root.theme_border; text-primary: root.theme_text_primary;
                                        clicked => { root.hotkey_str = "Ctrl+Space"; root.commit_all(); }
                                    }
                                    ActionBtn {
                                        label: "Alt+Space";
                                        accent: root.theme_accent; surface-bg: root.theme_surface_bg;
                                        selected-bg: root.theme_selected_bg; border-col: root.theme_border; text-primary: root.theme_text_primary;
                                        clicked => { root.hotkey_str = "Alt+Space"; root.commit_all(); }
                                    }
                                }
                            }
                        }

                        // Result Sources Toggles
                        SettingCard {
                            card-bg: root.theme_card_bg; border-col: root.theme_border;
                            VerticalLayout {
                                padding: 12px;
                                spacing: 10px;

                                HorizontalLayout {
                                    alignment: space-between;
                                    Text { text: "Show Start Menu Applications"; font-size: 12.5px; color: root.theme_text_primary; vertical-alignment: center; }
                                    PillSwitch {
                                        checked: root.show_apps;
                                        accent: root.theme_accent; surface-bg: root.theme_surface_bg; border-col: root.theme_border;
                                        toggled(v) => { root.show_apps = v; root.commit_all(); }
                                    }
                                }
                                HorizontalLayout {
                                    alignment: space-between;
                                    Text { text: "Show Built-in System Commands (Task Manager, cmd, etc.)"; font-size: 12.5px; color: root.theme_text_primary; vertical-alignment: center; }
                                    PillSwitch {
                                        checked: root.enable_builtin_cmds;
                                        accent: root.theme_accent; surface-bg: root.theme_surface_bg; border-col: root.theme_border;
                                        toggled(v) => { root.enable_builtin_cmds = v; root.commit_all(); }
                                    }
                                }
                                HorizontalLayout {
                                    alignment: space-between;
                                    Text { text: "Show Built-in Windows Settings (Display, Wi-Fi, Update)"; font-size: 12.5px; color: root.theme_text_primary; vertical-alignment: center; }
                                    PillSwitch {
                                        checked: root.enable_builtin_settings;
                                        accent: root.theme_accent; surface-bg: root.theme_surface_bg; border-col: root.theme_border;
                                        toggled(v) => { root.enable_builtin_settings = v; root.commit_all(); }
                                    }
                                }
                                HorizontalLayout {
                                    alignment: space-between;
                                    Text { text: "Show Palette Quick-Actions (Theme, Reload, Preferences)"; font-size: 12.5px; color: root.theme_text_primary; vertical-alignment: center; }
                                    PillSwitch {
                                        checked: root.enable_cmdpal_shortcuts;
                                        accent: root.theme_accent; surface-bg: root.theme_surface_bg; border-col: root.theme_border;
                                        toggled(v) => { root.enable_cmdpal_shortcuts = v; root.commit_all(); }
                                    }
                                }
                            }
                        }

                        // Category Priority Order
                        SettingCard {
                            card-bg: root.theme_card_bg; border-col: root.theme_border;
                            VerticalLayout {
                                padding: 12px;
                                spacing: 6px;

                                Text { text: "Shelf Priority Order"; font-size: 12.5px; font-weight: 600; color: root.theme_text_primary; }
                                Text { text: "Controls tie-breaking order when multiple shelves match a query"; font-size: 11px; color: root.theme_text_muted; }

                                for cat[idx] in root.category_entries : Rectangle {
                                    height: 36px;
                                    border-radius: 5px;
                                    background: root.theme_surface_bg;

                                    HorizontalLayout {
                                        padding-left: 10px;
                                        padding-right: 8px;
                                        spacing: 8px;
                                        alignment: center;

                                        Text { text: "#" + cat.rank; font-size: 11px; font-weight: 700; color: root.theme_accent; width: 22px; vertical-alignment: center; }
                                        Text { text: cat.icon; font-size: 12.5px; width: 18px; vertical-alignment: center; }
                                        Text { text: cat.label; font-size: 12px; font-weight: 600; color: root.theme_text_primary; horizontal-stretch: 1; vertical-alignment: center; }

                                        ActionBtn {
                                            label: "↑";
                                            accent: root.theme_accent; surface-bg: root.theme_card_bg;
                                            selected-bg: root.theme_selected_bg; border-col: root.theme_border; text-primary: root.theme_text_primary;
                                            clicked => { if (!cat.is_first) { root.move_category_up(idx); } }
                                        }
                                        ActionBtn {
                                            label: "↓";
                                            accent: root.theme_accent; surface-bg: root.theme_card_bg;
                                            selected-bg: root.theme_selected_bg; border-col: root.theme_border; text-primary: root.theme_text_primary;
                                            clicked => { if (!cat.is_last) { root.move_category_down(idx); } }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // ------------------------------------------------------------
                // TAB 1: MULTI-FILE NOTE BANGS
                // ------------------------------------------------------------
                if root.active_tab == 1 : VerticalLayout {
                    spacing: 12px;

                    VerticalLayout {
                        spacing: 3px;
                        Text {
                            text: "Note Bangs (Multiple Text & Markdown Files)";
                            font-size: 16px;
                            font-weight: 700;
                            color: root.theme_text_primary;
                        }
                        Text {
                            text: "Bind different bangs (e.g. 'note', 'todo', 'work') to separate .txt or .md files. Type '<bang> ' in the palette to append lines or search existing lines.";
                            font-size: 11.5px;
                            color: root.theme_text_muted;
                            wrap: word-wrap;
                        }
                    }

                    // Add / Update Note Bang Form
                    SettingCard {
                        card-bg: root.theme_card_bg; border-col: root.theme_border;
                        VerticalLayout {
                            padding: 12px;
                            spacing: 8px;

                            Text { text: "Add or Update Note Bang"; font-size: 12px; font-weight: 600; color: root.theme_text_primary; }

                            HorizontalLayout {
                                spacing: 8px;
                                FlatInput {
                                    width: 105px;
                                    text <=> root.note_bang_input;
                                    placeholder: "Bang (todo)";
                                    surface-bg: root.theme_surface_bg; border-col: root.theme_border;
                                    accent: root.theme_accent; text-primary: root.theme_text_primary; text-muted: root.theme_text_muted;
                                }
                                FlatInput {
                                    width: 150px;
                                    text <=> root.note_name_input;
                                    placeholder: "Label (To-Do List)";
                                    surface-bg: root.theme_surface_bg; border-col: root.theme_border;
                                    accent: root.theme_accent; text-primary: root.theme_text_primary; text-muted: root.theme_text_muted;
                                }
                                FlatInput {
                                    horizontal-stretch: 1;
                                    text <=> root.note_file_input;
                                    placeholder: "File path (e.g. todo.txt or D:\\notes\\work.md)";
                                    surface-bg: root.theme_surface_bg; border-col: root.theme_border;
                                    accent: root.theme_accent; text-primary: root.theme_text_primary; text-muted: root.theme_text_muted;
                                }
                                ActionBtn {
                                    label: "Save Bang";
                                    primary: true;
                                    accent: root.theme_accent;
                                    clicked => {
                                        root.upsert_note_bang(root.note_bang_input, root.note_name_input, root.note_file_input);
                                        root.note_bang_input = "";
                                        root.note_name_input = "";
                                        root.note_file_input = "";
                                    }
                                }
                            }
                        }
                    }

                    // Configured Note Bangs List
                    SettingCard {
                        vertical-stretch: 1;
                        card-bg: root.theme_card_bg; border-col: root.theme_border;

                        ScrollView {
                            width: 100%;
                            height: 100%;
                            viewport-height: root.note_entries.length * 48px;

                            VerticalLayout {
                                padding: 10px;
                                spacing: 6px;

                                for item in root.note_entries : Rectangle {
                                    height: 42px;
                                    border-radius: 6px;
                                    background: root.theme_surface_bg;

                                    HorizontalLayout {
                                        padding-left: 12px;
                                        padding-right: 8px;
                                        spacing: 10px;
                                        alignment: center;

                                        Rectangle {
                                            width: 64px;
                                            height: 24px;
                                            border-radius: 4px;
                                            background: root.theme_accent.with-alpha(0.15);
                                            Text {
                                                text: "!" + item.bang;
                                                font-size: 11.5px;
                                                font-weight: 700;
                                                color: root.theme_accent;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }

                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            alignment: center;
                                            Text { text: item.name; font-size: 12.5px; font-weight: 600; color: root.theme_text_primary; overflow: elide; }
                                            Text { text: item.file_path; font-size: 11px; color: root.theme_text_muted; overflow: elide; }
                                        }

                                        ActionBtn {
                                            label: "Edit";
                                            accent: root.theme_accent; surface-bg: root.theme_card_bg;
                                            selected-bg: root.theme_selected_bg; border-col: root.theme_border; text-primary: root.theme_text_primary;
                                            clicked => {
                                                root.note_bang_input = item.bang;
                                                root.note_name_input = item.name;
                                                root.note_file_input = item.file_path;
                                            }
                                        }

                                        ActionBtn {
                                            label: "Open File";
                                            accent: root.theme_accent; surface-bg: root.theme_card_bg;
                                            selected-bg: root.theme_selected_bg; border-col: root.theme_border; text-primary: root.theme_text_primary;
                                            clicked => { root.open_note_file(item.file_path); }
                                        }

                                        ActionBtn {
                                            label: "Remove";
                                            danger: true;
                                            border-col: root.theme_border;
                                            clicked => { root.remove_note_bang(item.bang); }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // ------------------------------------------------------------
                // TAB 2: WEB SEARCH & BANGS
                // ------------------------------------------------------------
                if root.active_tab == 2 : VerticalLayout {
                    spacing: 12px;

                    Text {
                        text: "Web Search & Bangs";
                        font-size: 16px;
                        font-weight: 700;
                        color: root.theme_text_primary;
                    }

                    SettingCard {
                        card-bg: root.theme_card_bg; border-col: root.theme_border;
                        VerticalLayout {
                            padding: 12px;
                            spacing: 8px;

                            Text { text: "Default Fallback Search Engine"; font-size: 12.5px; font-weight: 600; color: root.theme_text_primary; }

                            HorizontalLayout {
                                spacing: 6px;
                                ActionBtn {
                                    label: "Google"; primary: root.default_search_engine == "google";
                                    accent: root.theme_accent; surface-bg: root.theme_surface_bg; selected-bg: root.theme_selected_bg; border-col: root.theme_border; text-primary: root.theme_text_primary;
                                    clicked => { root.default_search_engine = "google"; root.commit_all(); }
                                }
                                ActionBtn {
                                    label: "DuckDuckGo"; primary: root.default_search_engine == "duckduckgo";
                                    accent: root.theme_accent; surface-bg: root.theme_surface_bg; selected-bg: root.theme_selected_bg; border-col: root.theme_border; text-primary: root.theme_text_primary;
                                    clicked => { root.default_search_engine = "duckduckgo"; root.commit_all(); }
                                }
                                ActionBtn {
                                    label: "Bing"; primary: root.default_search_engine == "bing";
                                    accent: root.theme_accent; surface-bg: root.theme_surface_bg; selected-bg: root.theme_selected_bg; border-col: root.theme_border; text-primary: root.theme_text_primary;
                                    clicked => { root.default_search_engine = "bing"; root.commit_all(); }
                                }
                                ActionBtn {
                                    label: "Brave"; primary: root.default_search_engine == "brave";
                                    accent: root.theme_accent; surface-bg: root.theme_surface_bg; selected-bg: root.theme_selected_bg; border-col: root.theme_border; text-primary: root.theme_text_primary;
                                    clicked => { root.default_search_engine = "brave"; root.commit_all(); }
                                }
                                ActionBtn {
                                    label: "Perplexity"; primary: root.default_search_engine == "perplexity";
                                    accent: root.theme_accent; surface-bg: root.theme_surface_bg; selected-bg: root.theme_selected_bg; border-col: root.theme_border; text-primary: root.theme_text_primary;
                                    clicked => { root.default_search_engine = "perplexity"; root.commit_all(); }
                                }
                                ActionBtn {
                                    label: "Custom"; primary: root.default_search_engine == "custom";
                                    accent: root.theme_accent; surface-bg: root.theme_surface_bg; selected-bg: root.theme_selected_bg; border-col: root.theme_border; text-primary: root.theme_text_primary;
                                    clicked => { root.default_search_engine = "custom"; root.commit_all(); }
                                }
                            }

                            if root.default_search_engine == "custom" : FlatInput {
                                text <=> root.custom_search_url;
                                placeholder: "Custom URL with {q} placeholder";
                                surface-bg: root.theme_surface_bg; border-col: root.theme_border;
                                accent: root.theme_accent; text-primary: root.theme_text_primary; text-muted: root.theme_text_muted;
                            }
                        }
                    }

                    // Add Web Bang
                    SettingCard {
                        card-bg: root.theme_card_bg; border-col: root.theme_border;
                        HorizontalLayout {
                            padding: 10px;
                            spacing: 8px;
                            FlatInput {
                                width: 100px;
                                text <=> root.new_bang_trigger;
                                placeholder: "Key (yt)";
                                surface-bg: root.theme_surface_bg; border-col: root.theme_border;
                                accent: root.theme_accent; text-primary: root.theme_text_primary; text-muted: root.theme_text_muted;
                            }
                            FlatInput {
                                horizontal-stretch: 1;
                                text <=> root.new_bang_url;
                                placeholder: "https://example.com/search?q={q}";
                                surface-bg: root.theme_surface_bg; border-col: root.theme_border;
                                accent: root.theme_accent; text-primary: root.theme_text_primary; text-muted: root.theme_text_muted;
                            }
                            ActionBtn {
                                label: "+ Add Bang";
                                primary: true;
                                accent: root.theme_accent;
                                clicked => {
                                    root.add_bang(root.new_bang_trigger, root.new_bang_url);
                                    root.new_bang_trigger = "";
                                    root.new_bang_url = "";
                                }
                            }
                        }
                    }

                    // Web Bangs List
                    SettingCard {
                        vertical-stretch: 1;
                        card-bg: root.theme_card_bg; border-col: root.theme_border;
                        ScrollView {
                            width: 100%;
                            height: 100%;
                            viewport-height: root.bang_entries.length * 40px;

                            VerticalLayout {
                                padding: 10px;
                                spacing: 5px;
                                for b in root.bang_entries : Rectangle {
                                    height: 34px;
                                    border-radius: 5px;
                                    background: root.theme_surface_bg;
                                    HorizontalLayout {
                                        padding-left: 10px;
                                        padding-right: 8px;
                                        spacing: 10px;
                                        alignment: center;
                                        Text { text: "!" + b.trigger; font-size: 12px; font-weight: 700; color: root.theme_accent; width: 65px; vertical-alignment: center; }
                                        Text { text: b.url; font-size: 11.5px; color: root.theme_text_muted; horizontal-stretch: 1; vertical-alignment: center; overflow: elide; }
                                        ActionBtn {
                                            label: "Remove"; danger: true; border-col: root.theme_border;
                                            clicked => { root.remove_bang(b.trigger); }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // ------------------------------------------------------------
                // TAB 3: COMMANDS & WINDOWS SETTINGS
                // ------------------------------------------------------------
                if root.active_tab == 3 : VerticalLayout {
                    spacing: 10px;

                    Text {
                        text: "System Commands & Windows Settings";
                        font-size: 16px;
                        font-weight: 700;
                        color: root.theme_text_primary;
                    }

                    // Custom Command & Custom Setting Add Row
                    SettingCard {
                        card-bg: root.theme_card_bg; border-col: root.theme_border;
                        VerticalLayout {
                            padding: 10px;
                            spacing: 6px;
                            HorizontalLayout {
                                spacing: 6px;
                                FlatInput {
                                    width: 145px; text <=> root.new_cmd_name; placeholder: "Cmd Name";
                                    surface-bg: root.theme_surface_bg; border-col: root.theme_border; accent: root.theme_accent; text-primary: root.theme_text_primary; text-muted: root.theme_text_muted;
                                }
                                FlatInput {
                                    horizontal-stretch: 1; text <=> root.new_cmd_val; placeholder: "Shell command (e.g. ipconfig /all)";
                                    surface-bg: root.theme_surface_bg; border-col: root.theme_border; accent: root.theme_accent; text-primary: root.theme_text_primary; text-muted: root.theme_text_muted;
                                }
                                ActionBtn {
                                    label: "+ Cmd"; primary: true; accent: root.theme_accent;
                                    clicked => {
                                        root.add_custom_cmd(root.new_cmd_name, root.new_cmd_val);
                                        root.new_cmd_name = ""; root.new_cmd_val = "";
                                    }
                                }
                            }
                            HorizontalLayout {
                                spacing: 6px;
                                FlatInput {
                                    width: 145px; text <=> root.new_set_name; placeholder: "Setting Name";
                                    surface-bg: root.theme_surface_bg; border-col: root.theme_border; accent: root.theme_accent; text-primary: root.theme_text_primary; text-muted: root.theme_text_muted;
                                }
                                FlatInput {
                                    horizontal-stretch: 1; text <=> root.new_set_val; placeholder: "URI (e.g. ms-settings:OptionalFeatures)";
                                    surface-bg: root.theme_surface_bg; border-col: root.theme_border; accent: root.theme_accent; text-primary: root.theme_text_primary; text-muted: root.theme_text_muted;
                                }
                                ActionBtn {
                                    label: "+ Setting"; primary: true; accent: root.theme_accent;
                                    clicked => {
                                        root.add_custom_setting(root.new_set_name, root.new_set_val);
                                        root.new_set_name = ""; root.new_set_val = "";
                                    }
                                }
                            }
                        }
                    }

                    FlatInput {
                        text <=> root.builtin_filter_text;
                        placeholder: "Filter built-in commands & Windows settings...";
                        surface-bg: root.theme_surface_bg; border-col: root.theme_border;
                        accent: root.theme_accent; text-primary: root.theme_text_primary; text-muted: root.theme_text_muted;
                        edited(t) => { root.builtin_filter_changed(t); }
                    }

                    HorizontalLayout {
                        vertical-stretch: 1;
                        spacing: 10px;

                        // Left: System Commands
                        SettingCard {
                            horizontal-stretch: 1;
                            card-bg: root.theme_card_bg; border-col: root.theme_border;
                            ScrollView {
                                width: 100%; height: 100%;
                                viewport-height: (root.custom_cmd_entries.length + root.builtin_cmd_entries.length) * 38px;
                                VerticalLayout {
                                    padding: 8px; spacing: 4px;
                                    for c[idx] in root.custom_cmd_entries : Rectangle {
                                        height: 32px; border-radius: 5px; background: root.theme_surface_bg;
                                        HorizontalLayout {
                                            padding-left: 8px; padding-right: 6px; spacing: 6px; alignment: center;
                                            Text { text: c.name; font-size: 11.5px; font-weight: 600; color: root.theme_accent; horizontal-stretch: 1; overflow: elide; vertical-alignment: center; }
                                            ActionBtn { label: "✕"; danger: true; border-col: root.theme_border; clicked => { root.remove_custom_cmd(idx); } }
                                        }
                                    }
                                    for item in root.builtin_cmd_entries : Rectangle {
                                        height: 32px; border-radius: 5px; background: root.theme_surface_bg;
                                        HorizontalLayout {
                                            padding-left: 8px; padding-right: 8px; spacing: 6px; alignment: center;
                                            Text { text: item.title; font-size: 11.5px; color: root.theme_text_primary; horizontal-stretch: 1; overflow: elide; vertical-alignment: center; }
                                            PillSwitch {
                                                checked: item.enabled;
                                                accent: root.theme_accent; surface-bg: root.theme_card_bg; border-col: root.theme_border;
                                                toggled(v) => { root.toggle_builtin_cmd(item.id, v); }
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // Right: Windows Settings
                        SettingCard {
                            horizontal-stretch: 1;
                            card-bg: root.theme_card_bg; border-col: root.theme_border;
                            ScrollView {
                                width: 100%; height: 100%;
                                viewport-height: (root.custom_setting_entries.length + root.builtin_setting_entries.length) * 38px;
                                VerticalLayout {
                                    padding: 8px; spacing: 4px;
                                    for s[idx] in root.custom_setting_entries : Rectangle {
                                        height: 32px; border-radius: 5px; background: root.theme_surface_bg;
                                        HorizontalLayout {
                                            padding-left: 8px; padding-right: 6px; spacing: 6px; alignment: center;
                                            Text { text: s.name; font-size: 11.5px; font-weight: 600; color: root.theme_accent; horizontal-stretch: 1; overflow: elide; vertical-alignment: center; }
                                            ActionBtn { label: "✕"; danger: true; border-col: root.theme_border; clicked => { root.remove_custom_setting(idx); } }
                                        }
                                    }
                                    for item in root.builtin_setting_entries : Rectangle {
                                        height: 32px; border-radius: 5px; background: root.theme_surface_bg;
                                        HorizontalLayout {
                                            padding-left: 8px; padding-right: 8px; spacing: 6px; alignment: center;
                                            Text { text: item.title; font-size: 11.5px; color: root.theme_text_primary; horizontal-stretch: 1; overflow: elide; vertical-alignment: center; }
                                            PillSwitch {
                                                checked: item.enabled;
                                                accent: root.theme_accent; surface-bg: root.theme_card_bg; border-col: root.theme_border;
                                                toggled(v) => { root.toggle_builtin_setting(item.id, v); }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // ------------------------------------------------------------
                // TAB 4: APPS & CUSTOM FILE SCAN FOLDERS
                // ------------------------------------------------------------
                if root.active_tab == 4 : VerticalLayout {
                    spacing: 10px;

                    Text {
                        text: "Applications & Custom Scan Folders";
                        font-size: 16px;
                        font-weight: 700;
                        color: root.theme_text_primary;
                    }

                    // Custom Scan Folders Card
                    SettingCard {
                        card-bg: root.theme_card_bg; border-col: root.theme_border;
                        VerticalLayout {
                            padding: 10px;
                            spacing: 6px;
                            HorizontalLayout {
                                spacing: 8px;
                                FlatInput {
                                    horizontal-stretch: 1;
                                    text <=> root.new_folder_input;
                                    placeholder: "Add folder to index (e.g. C:\\Projects)";
                                    surface-bg: root.theme_surface_bg; border-col: root.theme_border;
                                    accent: root.theme_accent; text-primary: root.theme_text_primary; text-muted: root.theme_text_muted;
                                }
                                ActionBtn {
                                    label: "+ Add Folder"; primary: true; accent: root.theme_accent;
                                    clicked => {
                                        root.add_scan_folder(root.new_folder_input);
                                        root.new_folder_input = "";
                                    }
                                }
                            }

                            for folder[idx] in root.folder_entries : Rectangle {
                                height: 30px; border-radius: 5px; background: root.theme_surface_bg;
                                HorizontalLayout {
                                    padding-left: 10px; padding-right: 6px; spacing: 8px; alignment: center;
                                    Text { text: folder; font-size: 11.5px; color: root.theme_text_primary; horizontal-stretch: 1; overflow: elide; vertical-alignment: center; }
                                    ActionBtn { label: "Remove"; danger: true; border-col: root.theme_border; clicked => { root.remove_scan_folder(idx); } }
                                }
                            }
                        }
                    }

                    FlatInput {
                        text <=> root.app_filter_text;
                        placeholder: "Filter indexed Start Menu applications...";
                        surface-bg: root.theme_surface_bg; border-col: root.theme_border;
                        accent: root.theme_accent; text-primary: root.theme_text_primary; text-muted: root.theme_text_muted;
                        edited(t) => { root.app_filter_changed(t); }
                    }

                    SettingCard {
                        vertical-stretch: 1;
                        card-bg: root.theme_card_bg; border-col: root.theme_border;
                        ScrollView {
                            width: 100%; height: 100%;
                            viewport-height: root.app_entries.length * 38px;
                            VerticalLayout {
                                padding: 8px; spacing: 4px;
                                for app in root.app_entries : Rectangle {
                                    height: 34px; border-radius: 5px; background: root.theme_surface_bg;
                                    HorizontalLayout {
                                        padding-left: 10px; padding-right: 10px; spacing: 10px; alignment: center;
                                        Text { text: app.name; font-size: 12px; color: root.theme_text_primary; horizontal-stretch: 1; overflow: elide; vertical-alignment: center; }
                                        PillSwitch {
                                            checked: app.visible;
                                            accent: root.theme_accent; surface-bg: root.theme_card_bg; border-col: root.theme_border;
                                            toggled(v) => { root.toggle_app_visibility(app.name, v); }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // ------------------------------------------------------------
                // TAB 5: APPEARANCE & SHELL PATHS
                // ------------------------------------------------------------
                if root.active_tab == 5 : ScrollView {
                    width: 100%; height: 100%;
                    VerticalLayout {
                        spacing: 12px;
                        padding-right: 6px;

                        Text {
                            text: "Appearance & Paths";
                            font-size: 16px;
                            font-weight: 700;
                            color: root.theme_text_primary;
                        }

                        SettingCard {
                            card-bg: root.theme_card_bg; border-col: root.theme_border;
                            VerticalLayout {
                                padding: 12px; spacing: 10px;
                                Text { text: "Color Theme"; font-size: 12.5px; font-weight: 600; color: root.theme_text_primary; }
                                HorizontalLayout {
                                    spacing: 8px;
                                    ActionBtn {
                                        label: "Fluent Dark (Default)"; primary: root.theme_mode != "custom";
                                        accent: root.theme_accent; surface-bg: root.theme_surface_bg; selected-bg: root.theme_selected_bg; border-col: root.theme_border; text-primary: root.theme_text_primary;
                                        clicked => { root.theme_mode = "powertoys"; root.commit_all(); }
                                    }
                                    ActionBtn {
                                        label: "Custom Hex Colors"; primary: root.theme_mode == "custom";
                                        accent: root.theme_accent; surface-bg: root.theme_surface_bg; selected-bg: root.theme_selected_bg; border-col: root.theme_border; text-primary: root.theme_text_primary;
                                        clicked => { root.theme_mode = "custom"; root.commit_all(); }
                                    }
                                }

                                if root.theme_mode == "custom" : VerticalLayout {
                                    spacing: 8px;
                                    HorizontalLayout {
                                        spacing: 8px;
                                        Text { text: "Window BG"; width: 80px; font-size: 11.5px; color: root.theme_text_muted; vertical-alignment: center; }
                                        FlatInput { horizontal-stretch: 1; text <=> root.custom_window_bg; surface-bg: root.theme_surface_bg; border-col: root.theme_border; accent: root.theme_accent; text-primary: root.theme_text_primary; text-muted: root.theme_text_muted; }
                                        Text { text: "Surface BG"; width: 80px; font-size: 11.5px; color: root.theme_text_muted; vertical-alignment: center; }
                                        FlatInput { horizontal-stretch: 1; text <=> root.custom_surface_bg; surface-bg: root.theme_surface_bg; border-col: root.theme_border; accent: root.theme_accent; text-primary: root.theme_text_primary; text-muted: root.theme_text_muted; }
                                    }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        Text { text: "Card BG"; width: 80px; font-size: 11.5px; color: root.theme_text_muted; vertical-alignment: center; }
                                        FlatInput { horizontal-stretch: 1; text <=> root.custom_card_bg; surface-bg: root.theme_surface_bg; border-col: root.theme_border; accent: root.theme_accent; text-primary: root.theme_text_primary; text-muted: root.theme_text_muted; }
                                        Text { text: "Selected BG"; width: 80px; font-size: 11.5px; color: root.theme_text_muted; vertical-alignment: center; }
                                        FlatInput { horizontal-stretch: 1; text <=> root.custom_selected_bg; surface-bg: root.theme_surface_bg; border-col: root.theme_border; accent: root.theme_accent; text-primary: root.theme_text_primary; text-muted: root.theme_text_muted; }
                                    }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        Text { text: "Border"; width: 80px; font-size: 11.5px; color: root.theme_text_muted; vertical-alignment: center; }
                                        FlatInput { horizontal-stretch: 1; text <=> root.custom_border; surface-bg: root.theme_surface_bg; border-col: root.theme_border; accent: root.theme_accent; text-primary: root.theme_text_primary; text-muted: root.theme_text_muted; }
                                        Text { text: "Accent"; width: 80px; font-size: 11.5px; color: root.theme_text_muted; vertical-alignment: center; }
                                        FlatInput { horizontal-stretch: 1; text <=> root.custom_accent; surface-bg: root.theme_surface_bg; border-col: root.theme_border; accent: root.theme_accent; text-primary: root.theme_text_primary; text-muted: root.theme_text_muted; }
                                    }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        Text { text: "Text Primary"; width: 80px; font-size: 11.5px; color: root.theme_text_muted; vertical-alignment: center; }
                                        FlatInput { horizontal-stretch: 1; text <=> root.custom_text_primary; surface-bg: root.theme_surface_bg; border-col: root.theme_border; accent: root.theme_accent; text-primary: root.theme_text_primary; text-muted: root.theme_text_muted; }
                                        Text { text: "Text Muted"; width: 80px; font-size: 11.5px; color: root.theme_text_muted; vertical-alignment: center; }
                                        FlatInput { horizontal-stretch: 1; text <=> root.custom_text_muted; surface-bg: root.theme_surface_bg; border-col: root.theme_border; accent: root.theme_accent; text-primary: root.theme_text_primary; text-muted: root.theme_text_muted; }
                                    }
                                }
                            }
                        }

                        SettingCard {
                            card-bg: root.theme_card_bg; border-col: root.theme_border;
                            VerticalLayout {
                                padding: 12px; spacing: 8px;
                                Text { text: "Custom Shell Executable"; font-size: 12.5px; font-weight: 600; color: root.theme_text_primary; }
                                FlatInput {
                                    text <=> root.custom_cmd_path;
                                    placeholder: "cmd.exe";
                                    surface-bg: root.theme_surface_bg; border-col: root.theme_border; accent: root.theme_accent; text-primary: root.theme_text_primary; text-muted: root.theme_text_muted;
                                }
                            }
                        }
                    }
                }
            }

            // Persistent Bottom Action Bar
            Rectangle {
                height: 1px;
                background: root.theme_border;
            }

            HorizontalLayout {
                height: 32px;
                spacing: 8px;
                alignment: end;

                ActionBtn {
                    label: "Close";
                    accent: root.theme_accent; surface-bg: root.theme_surface_bg;
                    selected-bg: root.theme_selected_bg; border-col: root.theme_border; text-primary: root.theme_text_primary;
                    clicked => { root.close_window(); }
                }

                ActionBtn {
                    label: "Save Changes";
                    primary: true;
                    accent: root.theme_accent;
                    clicked => { root.commit_all(); }
                }
            }
        }
    }
}

